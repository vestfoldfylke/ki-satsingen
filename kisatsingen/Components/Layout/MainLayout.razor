@inherits LayoutComponentBase

<div class="page">
    <div class="sidebar">
        <NavMenu/>
    </div>

    <main>
        <article class="content">
            @Body
        </article>
    </main>
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@* Host for Radzen's portal-rendered components (tooltips, dialogs, context menus).
   RadzenChart's hover tooltip rides on TooltipService — without this anchor the
   tooltip DOM has nowhere to land and never becomes visible. *@
<RadzenComponents />
