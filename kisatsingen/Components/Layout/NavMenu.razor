<div class="navbar">
    <div class="sidebar-top">
        <button
            type="button"
            class="ds-button"
            data-variant="tertiary"
            data-size="sm"
            data-icon="true"
            aria-label="Åpne meny"
            aria-controls="sidebar-panel"
            popovertarget="sidebar-panel"
        >
            <span class="material-symbols-outlined" aria-hidden="true">menu</span>
        </button>
    </div>

    <div id="sidebar-panel" class="sidebar-panel" popover="auto">
        <div class="sidebar-panel-header">
            <nav class="nav-primary">
                <div class="logo-container">
                    <img src="favicon-32x32.png" alt="Vestfold fylke logo" />
                    <span>KI-satsingen</span>
                </div>
                <div class="nav-item">
                    <button
                        class="ds-button chat-sidebar-new-chat-button"
                        type="button"
                        data-variant="tertiary"
                        data-color="accent"
                        popovertarget="sidebar-panel"
                        popovertargetaction="hide"
                        @onclick="StartNewChatAsync"
                    >
                        <span class="material-symbols-outlined" aria-hidden="true">edit_square</span>
                        Ny samtale
                    </button>
                </div>
            </nav>

            <button
                type="button"
                class="ds-button sidebar-panel-close"
                data-variant="tertiary"
                data-size="sm"
                data-icon="true"
                aria-label="Lukk meny"
                popovertarget="sidebar-panel"
                popovertargetaction="hide"
            >
                <span class="material-symbols-outlined" aria-hidden="true">close</span>
            </button>
        </div>

        <aside class="chat-sidebar" aria-label="Samtaler">
            <div class="chat-sidebar-header">
                <h2 class="ds-heading" data-size="sm">Samtaler</h2>
            </div>
            @if (ChatList.Count == 0)
            {
                <p class="ds-paragraph chat-sidebar-empty">Ingen samtaler enda</p>
            }
            else
            {
                <ul class="ds-list chat-sidebar-list">
                    @foreach (var entry in ChatList)
                    {
                        var menuId = $"chat-menu-{entry.Id}";
                        <li>
                            <div class="chat-sidebar-item @(entry.Id == Session.ChatId ? "chat-sidebar-item-active" : null)">
                                <a class="ds-link chat-sidebar-link" href="@($"/chat/{entry.Id}")" data-tooltip="@entry.Title">
                                    <span class="chat-sidebar-title">@entry.Title</span>
                                </a>
                                <button
                                    type="button"
                                    class="ds-button chat-sidebar-item-option-button"
                                    data-variant="tertiary"
                                    data-size="sm"
                                    data-icon="true"
                                    popovertarget="@menuId"
                                    aria-label="Valg for samtalen"
                                    data-tooltip="Valg for samtalen"
                                >
                                    <span class="material-symbols-outlined" aria-hidden="true">more_vert</span>
                                </button>
                                <div class="ds-dropdown chat-sidebar-item-option-dropdown-menu" data-placement="bottom-end" id="@menuId" popover>
                                    <ul>
                                        <li>
                                            <button
                                                type="button"
                                                data-size="sm"
                                                class="ds-button"
                                                data-variant="tertiary"
                                                @onclick="() => RenameChatAsync(entry.Id, entry.Title)">
                                                <span class="material-symbols-outlined" aria-hidden="true">edit</span>
                                                Endre
                                            </button>
                                        </li>
                                        <li>
                                            <button
                                                type="button"
                                                data-size="sm"
                                                class="ds-button"
                                                data-variant="tertiary"
                                                @onclick="() => DeleteChatAsync(entry.Id)">
                                                <span class="material-symbols-outlined" aria-hidden="true">delete</span>
                                                Slett
                                            </button>
                                        </li>
                                    </ul>
                                </div>
                            </div>
                        </li>
                    }
                </ul>
            }
        </aside>

        <div class="user">
            <AuthorizeView>
                <Authorized>
                    <hr aria-hidden="true" class="ds-divider"/>
                    <div class="chat-sidebar-item">
                        <button class="ds-button chat-sidebar-user-button"
                            type="button"
                            data-variant="tertiary"
                            data-color="neutral"
                            popovertarget="user-menu-dropdown"
                            data-tooltip="Brukermeny"
                        >
                            <span
                                aria-hidden="true"
                                class="ds-avatar"
                                data-size="xs"
                                data-color="accent"
                            ></span>
                            <span class="ds-paragraph chat-sidebar-title" data-size="sm"><strong>@context.User.FindFirst("name")?.Value</strong></span>
                            <span class="material-symbols-outlined" aria-hidden="true">keyboard_arrow_down</span>
                        </button>

                        <div
                            id="user-menu-dropdown"
                            class="ds-dropdown"
                            popover="auto"
                            data-placement="top-start"
                        >
                            <h2 id="user-menu-heading" class="ds-heading"><strong>Meg og mitt</strong></h2>
                            <ul aria-labelledby="user-menu-heading">
                                <li>
                                    <NavLink class="ds-button"
                                        data-variant="tertiary"
                                        data-color="accent"
                                        href="usage">
                                        <span class="material-symbols-outlined" aria-hidden="true">data_usage</span>
                                        Mitt forbruk
                                    </NavLink>
                                </li>
                            </ul>

                            <AuthorizeView Policy="IsAdministrator" Context="adminContext">
                                <hr aria-hidden="true" class="ds-divider"/>
                                <h2 id="admin-menu-heading" class="ds-heading"><strong>Administrator</strong></h2>
                                <ul aria-labelledby="admin-menu-heading">
                                    <li>
                                        <NavLink class="ds-button"
                                            data-variant="tertiary"
                                            data-color="accent"
                                            href="administration/usage">
                                            <span class="material-symbols-outlined" aria-hidden="true">data_usage</span>
                                            Totalt forbruk
                                        </NavLink>
                                    </li>
                                </ul>
                            </AuthorizeView>
                        </div>
                    </div>
                </Authorized>
            </AuthorizeView>
        </div>
    </div>
</div>
