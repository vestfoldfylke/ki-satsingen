<div class="navbar">
    <div class="sidebar-header">
        <button
            type="button"
            class="ds-button sidebar-panel-open"
            data-variant="tertiary"
            data-size="sm"
            data-icon="true"
            aria-label="Åpne meny"
            aria-controls="@SidebarPanelId"
            popovertarget="@SidebarPanelId"
        >
            <span class="material-symbols-outlined" aria-hidden="true">menu</span>
        </button>
    </div>

    <div id="@SidebarPanelId" class="sidebar-panel" popover="auto">
        <div class="sidebar-panel-header">
            <nav class="nav-primary">
                <div class="logo-container ds-paragraph">
                    vfKI
                </div>
                <a class="ds-button nav-primary-button" href="/new" data-variant="tertiary" data-color="accent">
                    <span class="material-symbols-outlined" aria-hidden="true">edit_square</span>
                    Ny samtale
                </a>
                <a class="ds-button nav-primary-button" href="/assistants" data-variant="tertiary" data-color="accent">
                    <span class="material-symbols-outlined" aria-hidden="true">smart_toy</span>
                    Assistenter
                </a>
            </nav>

            <button
                type="button"
                class="ds-button sidebar-panel-close"
                data-variant="tertiary"
                data-size="sm"
                data-icon="true"
                aria-label="Lukk meny"
                popovertarget="@SidebarPanelId"
                popovertargetaction="hide"
            >
                <span class="material-symbols-outlined" aria-hidden="true">close</span>
            </button>
        </div>

        <aside class="chat-list" aria-label="Samtaler">
            <div class="chat-list-header">
                <h2 class="ds-heading" data-size="sm">Samtaler</h2>
            </div>
            @if (ChatList.Count == 0)
            {
                <p class="ds-paragraph chat-list-empty">Ingen samtaler enda</p>
            }
            else
            {
                <ul class="ds-list chat-list-items">
                    @foreach (var entry in ChatList)
                    {
                        var menuId = $"chat-menu-{entry.Id}";
                        <li>
                            <div class="chat-list-item @(entry.Id == Session.ChatId ? "chat-list-item-active" : null)">
                                <a class="ds-link chat-list-link" href="@($"/chat/{entry.Id}")" data-tooltip="@entry.Title">
                                    <span class="chat-list-title">@entry.Title</span>
                                </a>
                                <button
                                    type="button"
                                    class="ds-button chat-list-item-option-button"
                                    data-variant="tertiary"
                                    data-size="sm"
                                    data-icon="true"
                                    popovertarget="@menuId"
                                    aria-label="Valg for samtalen"
                                    data-tooltip="Valg for samtalen"
                                >
                                    <span class="material-symbols-outlined" aria-hidden="true">more_vert</span>
                                </button>
                                <div class="ds-dropdown chat-list-item-option-dropdown-menu" data-placement="bottom-end" id="@menuId" popover>
                                    <ul>
                                        <li>
                                            <button type="button"
                                                    class="ds-button"
                                                    data-variant="tertiary"
                                                    command="show-modal"
                                                    commandfor="rename-chat-dialog"
                                                    @onclick="() => _renameDialog?.Load(entry)"
                                            >
                                                <span class="material-symbols-outlined" aria-hidden="true">edit</span>
                                                Endre navn
                                            </button>
                                        </li>
                                        <li>
                                            <button type="button"
                                                    class="ds-button"
                                                    data-variant="tertiary"
                                                    data-color="danger"
                                                    command="show-modal"
                                                    commandfor="delete-chat-dialog"
                                                    @onclick="() => _deleteDialog?.Load(entry)"
                                            >
                                                <span class="material-symbols-outlined" aria-hidden="true">delete</span>
                                                Slett samtale
                                            </button>
                                        </li>
                                    </ul>
                                </div>
                            </div>
                        </li>
                    }
                </ul>
            }

            <RenameChatDialog @ref="_renameDialog" Id="rename-chat-dialog" />
            <DeleteChatDialog @ref="_deleteDialog" Id="delete-chat-dialog" />
        </aside>

        <div class="user-menu">
            <AuthorizeView>
                <Authorized>
                    <hr aria-hidden="true" class="ds-divider"/>
                    <div class="user-menu-item">
                        <button class="ds-button user-menu-button"
                            type="button"
                            data-variant="tertiary"
                            data-color="neutral"
                            popovertarget="user-menu-dropdown"
                            data-tooltip="Brukermeny"
                        >
                            <span
                                aria-hidden="true"
                                class="ds-avatar"
                                data-size="xs"
                                data-color="accent"
                            ></span>
                            <span class="ds-paragraph user-menu-button-title" data-size="sm"><strong>@context.User.FindFirst("name")?.Value</strong></span>
                            <span class="material-symbols-outlined" aria-hidden="true">keyboard_arrow_down</span>
                        </button>

                        <div
                            id="user-menu-dropdown"
                            class="ds-dropdown"
                            popover="auto"
                            data-placement="top-start"
                        >
                            <h2 id="user-menu-heading" class="ds-heading"><strong>Meg og mitt</strong></h2>
                            <ul aria-labelledby="user-menu-heading">
                                <li>
                                    <NavLink class="ds-button"
                                        data-variant="tertiary"
                                        data-color="accent"
                                        href="usage">
                                        <span class="material-symbols-outlined" aria-hidden="true">data_usage</span>
                                        Mitt forbruk
                                    </NavLink>
                                </li>
                            </ul>

                            <AuthorizeView Policy="@AuthorizationPolicies.IsAdministrator" Context="adminContext">
                                <hr aria-hidden="true" class="ds-divider"/>
                                <h2 id="admin-menu-heading" class="ds-heading"><strong>Administrator</strong></h2>
                                <ul aria-labelledby="admin-menu-heading">
                                    <li>
                                        <NavLink class="ds-button"
                                            data-variant="tertiary"
                                            data-color="accent"
                                            href="administration/usage">
                                            <span class="material-symbols-outlined" aria-hidden="true">data_usage</span>
                                            Totalt forbruk
                                        </NavLink>
                                    </li>
                                </ul>
                            </AuthorizeView>
                        </div>
                    </div>
                </Authorized>
            </AuthorizeView>
        </div>
    </div>
</div>
