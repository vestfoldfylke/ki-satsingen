@using kisatsingen.Components.Chat
@using kisatsingen.Components.ChatList

<div class="navbar">
    <div class="sidebar-header">
        <button
            type="button"
            class="ds-button sidebar-panel-open"
            data-variant="tertiary"
            data-size="sm"
            data-icon="true"
            aria-label="Åpne meny"
            aria-controls="@SidebarPanelId"
            popovertarget="@SidebarPanelId"
        >
            <span class="material-symbols-outlined" aria-hidden="true">menu</span>
        </button>
    </div>

    <div
        id="@SidebarPanelId"
        class="sidebar-panel"
        popover="auto"
    >
        <div class="sidebar-panel-header">
            <nav class="nav-primary">
                <div class="logo-container heading-font">
                    vfKI
                </div>
                <a
                    class="ds-button nav-primary-button"
                    href="/new"
                    data-variant="tertiary"
                    data-color="accent"
                >
                    <span class="material-symbols-outlined" aria-hidden="true">edit_square</span>
                    Ny samtale
                </a>
                <a
                    class="ds-button nav-primary-button"
                    href="/assistants"
                    data-variant="tertiary"
                    data-color="accent"
                >
                    <span class="material-symbols-outlined" aria-hidden="true">smart_toy</span>
                    Assistenter
                </a>
            </nav>

            <button
                type="button"
                class="ds-button sidebar-panel-close"
                data-variant="tertiary"
                data-size="sm"
                data-icon="true"
                aria-label="Lukk meny"
                popovertarget="@SidebarPanelId"
                popovertargetaction="hide"
            >
                <span class="material-symbols-outlined" aria-hidden="true">close</span>
            </button>
        </div>

        <aside class="chat-list" aria-label="Samtaler">
            <h2 class="ds-heading chat-list-header" data-size="xs">
                <button type="button"
                        class="ds-button nav-primary-button"
                        data-variant="tertiary"
                        aria-expanded="@_chatsOpen.ToString().ToLowerInvariant()"
                        aria-controls="chat-list-items"
                        @onclick="() => _chatsOpen = !_chatsOpen"
                >
                    Samtaler
                    <span class="material-symbols-outlined @(_chatsOpen ? "open" : null )" aria-hidden="true">
                        keyboard_arrow_right
                    </span>
                </button>
            </h2>
            @if (_chatsOpen)
            {
                <ChatListItems />

                <a
                    class="ds-button nav-primary-button"
                    href="/chats"
                    data-variant="tertiary"
                    data-color="accent"
                >
                    Gå til alle samtaler
                </a>
            }
        </aside>

        <div class="user-menu">
            <AuthorizeView>
                <Authorized>
                    <hr aria-hidden="true" class="ds-divider" />
                    <div class="user-menu-item">
                        <button
                            class="ds-button user-menu-button"
                            type="button"
                            data-variant="tertiary"
                            data-color="neutral"
                            popovertarget="@UserMenuId"
                            data-tooltip="Brukermeny"
                        >
                            <span aria-hidden="true" class="ds-avatar" data-size="xs" data-color="accent"></span>
                            <span
                                class="ds-paragraph user-menu-button-title"
                                data-size="sm"
                            ><strong>@context.User.FindFirst("name")?.Value</strong></span>
                            <span class="material-symbols-outlined" aria-hidden="true">keyboard_arrow_down</span>
                        </button>

                        <div id="@UserMenuId" class="ds-dropdown" popover="auto" data-placement="top-start">
                            <h2 id="user-menu-heading" class="ds-heading"><strong>Meg og mitt</strong></h2>
                            <ul aria-labelledby="user-menu-heading">
                                <li>
                                    <NavLink
                                        class="ds-button"
                                        data-variant="tertiary"
                                        data-color="accent"
                                        href="usage"
                                    >
                                        <span class="material-symbols-outlined" aria-hidden="true">data_usage</span>
                                        Mitt forbruk
                                    </NavLink>
                                </li>
                            </ul>

                            <AuthorizeView
                                Policy="@AuthorizationPolicies.IsAdministrator"
                                Context="adminContext"
                            >
                                <hr aria-hidden="true" class="ds-divider" />
                                <h2 id="admin-menu-heading" class="ds-heading"><strong>Administrator</strong></h2>
                                <ul aria-labelledby="admin-menu-heading">
                                    <li>
                                        <NavLink
                                            class="ds-button"
                                            data-variant="tertiary"
                                            data-color="accent"
                                            href="administration/usage"
                                        >
                                            <span class="material-symbols-outlined" aria-hidden="true">data_usage</span>
                                            Totalt forbruk
                                        </NavLink>
                                    </li>
                                </ul>
                            </AuthorizeView>
                        </div>
                    </div>
                </Authorized>
            </AuthorizeView>
        </div>
    </div>
</div>
