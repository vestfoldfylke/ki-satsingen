<div class="navbar">
    <div class="logo-container">
        <img src="favicon-32x32.png" alt="Vestfold fylke logo" />
        <span>KI-satsingen</span>
    </div>

    <div class="nav-scrollable">
        <nav class="nav-primary">
            <div class="nav-item">
                <button type="button" class="ds-link" @onclick="StartNewChatAsync">
                    <span class="material-symbols-outlined" aria-hidden="true">add_2</span>
                    Ny samtale
                </button>
            </div>
        </nav>

        <aside class="chat-sidebar" aria-label="Samtaler">
            <div class="chat-sidebar-header">
                <h2 class="ds-heading" data-size="sm">Samtaler</h2>
            </div>
            @if (ChatList.Count == 0)
            {
                <p class="ds-paragraph chat-sidebar-empty">Ingen samtaler enda</p>
            }
            else
            {
                <ul class="ds-list chat-sidebar-list">
                    @foreach (var entry in ChatList)
                    {
                        var menuId = $"chat-menu-{entry.Id}";
                        <li>
                            <div class="chat-sidebar-item @(entry.Id == Session.ChatId ? "chat-sidebar-item-active" : null)">
                                <a class="ds-link chat-sidebar-link" href="@($"/chat/{entry.Id}")" data-tooltip="@entry.Title">
                                    <span class="chat-sidebar-title">@entry.Title</span>
                                </a>
                                <button
                                    type="button"
                                    class="ds-button chat-sidebar-item-option-button"
                                    data-variant="tertiary"
                                    data-size="sm"
                                    data-icon="true"
                                    popovertarget="@menuId"
                                    aria-label="Valg for samtalen"
                                    data-tooltip="Valg for samtalen"
                                >
                                    <span class="material-symbols-outlined" aria-hidden="true">more_vert</span>
                                </button>
                                <div class="ds-dropdown chat-sidebar-item-option-dropdown-menu" data-placement="bottom-end" id="@menuId" popover>
                                    <ul>
                                        <li>
                                            <button
                                                type="button"
                                                data-size="sm"
                                                class="ds-button"
                                                data-variant="tertiary"
                                                @onclick="() => RenameChatAsync(entry.Id, entry.Title)">
                                                <span class="material-symbols-outlined" aria-hidden="true">edit</span>
                                                Endre
                                            </button>
                                        </li>
                                        <li>
                                            <button
                                                type="button"
                                                data-size="sm"
                                                class="ds-button"
                                                data-variant="tertiary"
                                                @onclick="() => DeleteChatAsync(entry.Id)">
                                                <span class="material-symbols-outlined" aria-hidden="true">delete</span>
                                                Slett
                                            </button>
                                        </li>
                                    </ul>
                                </div>
                            </div>
                        </li>
                    }
                </ul>
            }
        </aside>

        <div class="user">
            <AuthorizeView>
                <Authorized>
                    <div>
                        <button class="ds-button"
                                type="button"
                                data-variant="tertiary"
                                data-color="primary"
                                popovertarget="user-menu"
                                aria-haspopup="menu">
                            <span class="ds-paragraph" data-size="sm" ><strong>@context.User.Identity?.Name</strong></span>
                        </button>

                        <div id="user-menu" class="ds-dropdown" popover="auto" data-placement="top-start">
                            <ul role="menu" aria-label="Avansert brukermeny">
                                <span class="ds-paragraph" data-size="sm">@context.User.Identity?.Name</span>
                                <li role="none">
                                    <NavLink class="ds-button"
                                            type="button"
                                            data-variant="tertiary"
                                            data-color="neutral"
                                            role="menuitemradio"
                                            popovertargetaction="hide"
                                            data-placement="top"
                                            href="usage">

                                            <span class="material-symbols-outlined" aria-hidden="true">data_usage</span>
                                            Mitt forbruk
                                    </NavLink>
                                </li>

                                <br />

                                <AuthorizeView Policy="IsAdministrator">
                                    <Authorized>
                                        <li>
                                            <span class="ds-paragraph" data-size="sm">Administrator</span>
                                            <NavLink type="button"
                                                    class="ds-button user-menu-picker-option"
                                                    data-variant="tertiary"
                                                    data-color="neutral"
                                                    role="menuitemradio"
                                                    popovertargetaction="hide"
                                                    data-placement="right"
                                                    href="administration/usage">
                                                    
                                                    <span class="material-symbols-outlined" aria-hidden="true">data_usage</span>
                                                    <span class="ds-paragraph" data-size="sm">Totalt forbruk</span>
                                            </NavLink>
                                        </li>
                                    </Authorized>
                                </AuthorizeView>
                            </ul>
                        </div>
                    </div>
                </Authorized>
            </AuthorizeView>
        </div>
    </div>
</div>