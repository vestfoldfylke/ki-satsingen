<div class="navbar">
    <div class="logo-container">
        <img src="favicon-32x32.png" alt="Vestfold fylke logo" />
        <span>KI-satsingen</span>
    </div>

    <div class="nav-scrollable">
        <nav>
            <div class="nav-item">
                <NavLink class="ds-link" href="" Match="NavLinkMatch.All">
                    <span class="" aria-hidden="true"></span> Home
                </NavLink>
            </div>
            
            <div class="nav-item">
                <NavLink class="ds-link" href="chat">
                    <span class="" aria-hidden="true"></span> Chat
                </NavLink>
            </div>

            <div class="nav-item">
                <NavLink class="ds-link" href="weather">
                    <span class="" aria-hidden="true"></span> Weather
                </NavLink>
            </div>
        </nav>

        <div class="user">
            <AuthorizeView>
                <Authorized>
                    <span class="me-2">Connected: <strong>@context.User.Identity?.Name</strong></span>
                </Authorized>
            </AuthorizeView>
            
            <br />
            
            <AuthorizeView Policy="IsAdministrator">
                <Authorized>
                    <span>Du er admin du</span>
                </Authorized>
                <NotAuthorized>
                    <span>Du er ikke admin du</span>
                </NotAuthorized>
            </AuthorizeView>
        </div>
    </div>
</div>