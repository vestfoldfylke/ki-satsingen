@using kisatsingen.Components.Chat
<div class="navbar">
    <div class="sidebar-header">
        <button
            type="button"
            class="ds-button sidebar-panel-open"
            data-variant="tertiary"
            data-size="sm"
            data-icon="true"
            aria-label="Åpne meny"
            aria-controls="@SidebarPanelId"
            popovertarget="@SidebarPanelId"
        >
            <span class="material-symbols-outlined" aria-hidden="true">menu</span>
        </button>
    </div>

    <div
        id="@SidebarPanelId"
        class="sidebar-panel"
        popover="auto"
    >
        <div class="sidebar-panel-header">
            <nav class="nav-primary">
                <div class="logo-container heading-font">
                    vfKI
                </div>
                <a
                    class="ds-button nav-primary-button"
                    href="/new"
                    data-variant="tertiary"
                    data-color="accent"
                >
                    <span class="material-symbols-outlined" aria-hidden="true">edit_square</span>
                    Ny samtale
                </a>
                <a
                    class="ds-button nav-primary-button"
                    href="/assistants"
                    data-variant="tertiary"
                    data-color="accent"
                >
                    <span class="material-symbols-outlined" aria-hidden="true">smart_toy</span>
                    Assistenter
                </a>
            </nav>

            <button
                type="button"
                class="ds-button sidebar-panel-close"
                data-variant="tertiary"
                data-size="sm"
                data-icon="true"
                aria-label="Lukk meny"
                popovertarget="@SidebarPanelId"
                popovertargetaction="hide"
            >
                <span class="material-symbols-outlined" aria-hidden="true">close</span>
            </button>
        </div>

        <aside class="chat-list" aria-label="Samtaler">
            <button type="button"
                    class="ds-button chat-list-header nav-primary-button"
                    data-variant="tertiary"
                    aria-expanded="@_chatsOpen.ToString().ToLowerInvariant()"
                    aria-controls="chat-list-items"
                    @onclick="() => _chatsOpen = !_chatsOpen"
            >
                <h2 class="ds-heading" data-size="2xs">Samtaler</h2>
                <span class="material-symbols-outlined @(_chatsOpen ? "open" : null )" aria-hidden="true">
                    keyboard_arrow_right
                </span>
            </button>

            @if (_chatsOpen)
            {
                @if (ChatList.Count == 0)
                {
                    <p class="ds-paragraph chat-list-empty">Ingen samtaler enda</p>
                }
                else
                {
                    <ul class="ds-list chat-list-items" data-color="neutral">
                        @foreach (var entry in ChatList.Take(MaxVisibleChats))
                        {
                            var menuId = $"chat-menu-{entry.Id}";
                            var linkId = $"chat-link-{entry.Id}";
                            <li @key="entry.Id">
                                <div
                                    class="chat-list-item @(entry.Id == Session.ChatId ? "chat-list-item-active" : null)"
                                    data-clickdelegatefor="@linkId"
                                >
                                    <a
                                        class="ds-link chat-list-link"
                                        id="@linkId"
                                        href="@($"/chat/{entry.Id}")"
                                        data-tooltip="@(entry.Title.Length > TooltipOnChatListTitleLengthThreshold ? entry.Title : null)"
                                        data-placement="right"
                                        data-variant="tertiary"
                                        data-color="neutral"
                                    >
                                        @if (entry.AssistantId is not null)
                                        {
                                            <span class="material-symbols-outlined chat-list-bullet" aria-hidden="true">smart_toy</span>
                                            <span class="ds-sr-only">Assistent: </span>
                                        }
                                        else
                                        {
                                            <span class="material-symbols-outlined chat-list-bullet" aria-hidden="true">fiber_manual_record</span>
                                        }

                                        <span class="chat-list-title">@entry.Title</span>
                                    </a>
                                    <ChatListItemOptions
                                        MenuId="@menuId"
                                        Entry="@entry"
                                        RenameDialogId="rename-chat-dialog"
                                        DeleteDialogId="delete-chat-dialog"
                                        OnRename="@(e => _renameDialog?.Load(e))"
                                        OnDelete="@(e => _deleteDialog?.Load(e))"
                                    />
                                </div>
                            </li>
                        }
                    </ul>

                    <a
                        class="ds-button nav-primary-button"
                        href="/chats"
                        data-variant="tertiary"
                        data-color="accent"
                    >
                        Gå til alle samtaler
                    </a>
                }
            }

            <RenameChatDialog
                @ref="_renameDialog"
                Id="rename-chat-dialog"
            />
            <DeleteChatDialog
                @ref="_deleteDialog"
                Id="delete-chat-dialog"
            />
        </aside>

        <div class="user-menu">
            <AuthorizeView>
                <Authorized>
                    <hr aria-hidden="true" class="ds-divider" />
                    <div class="user-menu-item">
                        <button
                            class="ds-button user-menu-button"
                            type="button"
                            data-variant="tertiary"
                            data-color="neutral"
                            popovertarget="@UserMenuId"
                            data-tooltip="Brukermeny"
                        >
                            <span aria-hidden="true" class="ds-avatar" data-size="xs" data-color="accent"></span>
                            <span
                                class="ds-paragraph user-menu-button-title"
                                data-size="sm"
                            ><strong>@context.User.FindFirst("name")?.Value</strong></span>
                            <span class="material-symbols-outlined" aria-hidden="true">keyboard_arrow_down</span>
                        </button>

                        <div id="@UserMenuId" class="ds-dropdown" popover="auto" data-placement="top-start">
                            <h2 id="user-menu-heading" class="ds-heading"><strong>Meg og mitt</strong></h2>
                            <ul aria-labelledby="user-menu-heading">
                                <li>
                                    <NavLink
                                        class="ds-button"
                                        data-variant="tertiary"
                                        data-color="accent"
                                        href="usage"
                                    >
                                        <span class="material-symbols-outlined" aria-hidden="true">data_usage</span>
                                        Mitt forbruk
                                    </NavLink>
                                </li>
                            </ul>

                            <AuthorizeView
                                Policy="@AuthorizationPolicies.IsAdministrator"
                                Context="adminContext"
                            >
                                <hr aria-hidden="true" class="ds-divider" />
                                <h2 id="admin-menu-heading" class="ds-heading"><strong>Administrator</strong></h2>
                                <ul aria-labelledby="admin-menu-heading">
                                    <li>
                                        <NavLink
                                            class="ds-button"
                                            data-variant="tertiary"
                                            data-color="accent"
                                            href="administration/usage"
                                        >
                                            <span class="material-symbols-outlined" aria-hidden="true">data_usage</span>
                                            Totalt forbruk
                                        </NavLink>
                                    </li>
                                </ul>
                            </AuthorizeView>
                        </div>
                    </div>
                </Authorized>
            </AuthorizeView>
        </div>
    </div>
</div>
