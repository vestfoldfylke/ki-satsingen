@using kisatsingen.Services.KnowledgeFiles.Conversion

@* Loads FileId once and ignores later changes to it. *@
<div class="knowledge-file-viewer">
    @if (!_isLoaded)
    {
        <p class="ds-paragraph" data-size="sm">Laster …</p>
    }
    else if (_file is null)
    {
        <p class="ds-paragraph" data-size="sm">Fant ikke filen. Den kan være slettet.</p>
    }
    else
    {
        @if (ContentOriginNotes.For(_file.ContentOrigin) is { } note)
        {
            <p class="ds-alert ds-paragraph" data-size="sm" data-color="info">@note</p>
        }

        @if (_isTruncated)
        {
            <p class="ds-alert ds-paragraph" data-size="sm" data-color="warning">
                Filen er for lang til å vises i sin helhet. Viser begynnelsen.
            </p>
        }

        @* Filled by the browser, never by Blazor: see the code-behind. *@
        <pre @ref="_textElement" class="knowledge-file-viewer-text"></pre>
    }
</div>
