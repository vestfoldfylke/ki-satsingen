@using kisatsingen.Data.Entities

@* Saved knowledge files, a chat's or an assistant's alike: the list never
   knows whose they are. *@
<ul class="knowledge-file-list">
    @foreach (var file in Files)
    {
        <li @key="file.Id" class="knowledge-file-list-item">
            <div class="knowledge-file-list-file">
                <button
                    type="button"
                    class="ds-link knowledge-file-list-name"
                    command="@(ViewerDialogId is null ? null : "show-modal")"
                    commandfor="@ViewerDialogId"
                    @onclick="() => OnOpenRequested.InvokeAsync(file)"
                >
                    @file.FileName
                </button>
                <span class="ds-paragraph knowledge-file-list-date" data-size="xs"><NorwegianDate Value="file.CreatedAt" /></span>
            </div>
            @if (DeleteDialogId is not null)
            {
                <button
                    type="button"
                    class="ds-button"
                    data-variant="tertiary"
                    data-color="danger"
                    data-size="sm"
                    data-icon="true"
                    command="show-modal"
                    commandfor="@DeleteDialogId"
                    data-tooltip="@($"Slett {file.FileName}")"
                    aria-label="@($"Slett {file.FileName}")"
                    @onclick="() => OnDeleteRequested.InvokeAsync(file)"
                >
                    <span class="material-symbols-outlined" aria-hidden="true">delete</span>
                </button>
            }
        </li>
    }
</ul>

@code {
    [Parameter, EditorRequired]
    public required IReadOnlyList<KnowledgeFileMetadata> Files { get; set; }

    // The dialog that confirms a delete, owned by whoever owns the files. Each
    // file gets a delete button only when this is set.
    [Parameter]
    public string? DeleteDialogId { get; set; }

    // Raised when a file name is clicked, with that file.
    [Parameter, EditorRequired]
    public required EventCallback<KnowledgeFileMetadata> OnOpenRequested { get; set; }

    // The dialog that shows a file, owned by whoever owns the files. When set,
    // clicking a file name also opens that dialog.
    [Parameter]
    public string? ViewerDialogId { get; set; }

    // Raised as the dialog opens, with the file to delete.
    [Parameter]
    public EventCallback<KnowledgeFileMetadata> OnDeleteRequested { get; set; }
}
