@using kisatsingen.Components.Attachments
@using kisatsingen.Services.Attachments

@if (Notice is { } notice)
{
    <p class="ds-paragraph" data-size="sm" data-color="danger">@notice</p>
}

@if (Attachments.Count > 0)
{
    <p class="ds-alert ds-paragraph" data-size="xs">@AttachmentPrivacyWarning.Text</p>

    <ul class="composer-attachments" aria-label="Vedlegg">
        @foreach (var attachment in Attachments)
        {
            <li @key="attachment.AttachmentId"
                class="ds-card composer-attachment"
                data-size="sm"
                data-color="@(attachment.Status == AttachmentStatus.Rejected ? "danger" : "neutral")">
                <AttachmentItem FileName="@attachment.FileName"
                                SizeBytes="attachment.DeclaredSizeBytes"
                                Status="ToItemStatus(attachment)"
                                OnRemove="() => OnRemove.InvokeAsync(attachment.AttachmentId)" />
            </li>
        }
    </ul>
}

@code {
    [Parameter]
    public IReadOnlyList<ComposerAttachment> Attachments { get; set; } = [];

    [Parameter]
    public string? Notice { get; set; }

    [Parameter]
    public EventCallback<Guid> OnRemove { get; set; }

    private static AttachmentItemStatus? ToItemStatus(ComposerAttachment attachment) => attachment.Status switch
    {
        AttachmentStatus.Waiting => new AttachmentItemStatus.Waiting(),
        AttachmentStatus.Uploading => new AttachmentItemStatus.Uploading(attachment.UploadedPercent),
        AttachmentStatus.Ready => null,
        AttachmentStatus.Rejected => new AttachmentItemStatus.Failed(attachment.Rejection?.Message ?? "Kunne ikke legges ved"),
        _ => throw new ArgumentOutOfRangeException(nameof(attachment), attachment.Status, "Every attachment status needs an item status; add one to ToItemStatus.")
    };
}
