@using kisatsingen.Components.Attachments
@using kisatsingen.Services.Attachments

@if (Notice is { } notice)
{
    <p class="ds-paragraph" data-size="sm" data-color="danger">@notice</p>
}

@if (Attachments.Count > 0)
{
    <p class="ds-alert ds-paragraph" data-size="xs">@AttachmentPrivacyWarning.Text</p>

    <ul class="composer-attachments" aria-label="Vedlegg">
        @foreach (var attachment in Attachments)
        {
            <li @key="attachment.AttachmentId" class="composer-attachment">
                <AttachmentCard FileName="@attachment.FileName"
                                SizeBytes="attachment.DeclaredSizeBytes"
                                Status="ToCardStatus(attachment)"
                                OnRemove="() => OnRemove.InvokeAsync(attachment.AttachmentId)" />
            </li>
        }
    </ul>
}

@code {
    [Parameter]
    public IReadOnlyList<ComposerAttachment> Attachments { get; set; } = [];

    [Parameter]
    public string? Notice { get; set; }

    [Parameter]
    public EventCallback<Guid> OnRemove { get; set; }

    private static AttachmentCardStatus? ToCardStatus(ComposerAttachment attachment) => attachment.Status switch
    {
        AttachmentStatus.Waiting => new AttachmentCardStatus.Waiting(),
        AttachmentStatus.Uploading => new AttachmentCardStatus.Uploading(attachment.UploadedPercent),
        AttachmentStatus.Ready => null,
        AttachmentStatus.Rejected => new AttachmentCardStatus.Failed(attachment.Rejection?.Message ?? "Kunne ikke legges ved"),
        _ => throw new ArgumentOutOfRangeException(nameof(attachment), attachment.Status, "Every attachment status needs a card status; add one to ToCardStatus.")
    };
}
