@using kisatsingen.Services.Chat

<button class="ds-button"
        type="button"
        data-variant="tertiary"
        data-color="@TriggerColor"
        data-icon="true"
        popovertarget="@PopoverId"
        aria-label="@TriggerLabel">
    <span class="material-symbols-outlined">data_usage</span>
</button>

<div id="@PopoverId"
     class="ds-popover context-usage"
     popover="auto"
     data-placement="top"
     data-color="neutral">
    <div class="context-usage-content">
        <p class="ds-paragraph" data-size="sm"><strong>@StatusText</strong></p>

        <div class="context-usage-meter">
            <label class="ds-label" data-weight="regular" for="@MeterId">
                Kontekstvindu: @TokenCountFormat.Format(EstimatedContextTokens) av @TokenCountFormat.Format(Model.ContextWindowTokens)
            </label>
            @* Same thresholds as the trigger colour: green, then yellow, then red.
               A meter's low/high are inclusive of the calmer colour, while ClassifyContext
               switches at the threshold, hence the - 1. *@
            <meter id="@MeterId"
                   value="@EstimatedContextTokens"
                   min="0"
                   max="@Model.ContextWindowTokens"
                   low="@(Model.FillingThresholdTokens - 1)"
                   high="@(Model.NearlyFullThresholdTokens - 1)"
                   optimum="0"></meter>
        </div>

        @if (Usage is { } usage)
        {
            <dl>
                @if (usage.CombinedInputTokens is { } input)
                {
                    <dt>Sendt til KI</dt>
                    <dd>@TokenCountFormat.Format(input, usage.IsEstimated)</dd>
                }
                @if (usage.CombinedOutputTokens is { } output)
                {
                    <dt>Svar fra KI</dt>
                    <dd>@TokenCountFormat.Format(output, usage.IsEstimated)</dd>
                }
                @if (usage.CombinedTotalTokens is { } total)
                {
                    <dt>Totalt behandlet</dt>
                    <dd>@TokenCountFormat.Format(total, usage.IsEstimated)</dd>
                }
            </dl>
        }

        <p class="ds-paragraph context-usage-help" data-size="xs">
            Tallene er tokens: små tekstbiter på omtrent et ord eller en del av et ord.
            @if (Usage?.IsEstimated == true)
            {
                <text>Tall merket ~ er delvis anslått der KI-tjenesten ikke rapporterte forbruket.</text>
            }
        </p>
    </div>
</div>
