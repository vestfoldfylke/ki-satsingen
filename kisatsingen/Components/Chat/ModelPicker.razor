@using kisatsingen.Services.Chat

<div>
    <button class="ds-button"
            type="button"
            data-variant="tertiary"
            data-color="primary"
            popovertarget="@PopoverId"
            aria-haspopup="menu"
            aria-label="@TriggerLabel">
        <span class="ds-paragraph" data-size="sm">@Selected.DisplayName</span>
    </button>

    @* Opens upward: the composer sits at the bottom of the viewport. *@
    <div id="@PopoverId" class="ds-dropdown" popover="auto" data-placement="top-start">
        <ul role="menu" aria-label="Velg språkmodell">
            @foreach (var model in Models)
            {
                var isSelected = model.Key == Selected.Key;
                <li @key="model.Key" role="none">
                    @* A click inside popover="auto" doesn't dismiss it; this does,
                       without JS. *@
                    <button type="button"
                            class="ds-button model-picker-option"
                            data-variant="tertiary"
                            data-color="neutral"
                            role="menuitemradio"
                            aria-checked="@(isSelected ? "true" : "false")"
                            popovertarget="@PopoverId"
                            popovertargetaction="hide"
                            data-tooltip="@model.LongDescription"
                            data-placement="right"
                            @onclick="() => OnSelect.InvokeAsync(model.Key)">
                        <span class="model-picker-option-heading">
                            <span class="ds-paragraph" data-size="sm">@model.DisplayName</span>
                            @if (isSelected)
                            {
                                <span class="material-symbols-outlined" aria-hidden="true">check</span>
                            }
                        </span>
                        <span class="ds-paragraph" data-size="xs">@model.ShortDescription</span>
                        @* Shown before picking, so the choice is made knowing the
                        consequence. Still selectable: it is an estimate, and
                        it runs high. *@
                        @if (model.WouldOverflow(EstimatedContextTokens))
                        {
                            <span class="ds-alert ds-paragraph" data-size="xs" data-color="warning">
                                Samtalen er trolig for lang for denne modellen
                            </span>
                        }
                    </button>
                </li>
            }
        </ul>

        @* Switching mid-turn is allowed, so say when it takes effect rather than
           disabling the menu and leaving the user to guess. *@
        @if (IsBusy)
        {
            <p class="ds-alert ds-paragraph" data-size="xs">Et svar genereres nå. Byttet gjelder fra neste melding.</p>
        }
    </div>
</div>
