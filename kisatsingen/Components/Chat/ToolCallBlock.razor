@if (View.Outcome is ToolOutcome.Running)
{
    <p class="text-shimmer" data-color="neutral">@View.Title…</p>
}
else
{
    <details class="ds-details" data-color="@OutcomeColor">
        <summary>@View.Title</summary>
        <div>
            <pre class="chat-tool-output">@ShownText</pre>
            @if (View.UserFriendlyResult is not null)
            {
                <button
                    type="button"
                    class="ds-button"
                    data-variant="secondary"
                    data-size="sm"
                    data-color="neutral"
                    @onclick="() => _isShowingRawData = !_isShowingRawData"
                >
                    @if (_isShowingRawData)
                    {
                        <span class="material-symbols-outlined" aria-hidden="true">article</span>
                        <text>Vis lesevisning</text>
                    }
                    else
                    {
                        <span class="material-symbols-outlined" aria-hidden="true">data_object</span>
                        <text>Vis rådata</text>
                    }
                </button>
            }
        </div>
    </details>
    @if (View.Download is { } download)
    {
        <button
            type="button"
            class="ds-button chat-tool-download"
            data-variant="primary"
            data-size="sm"
            aria-busy="@(_isDownloading ? "true" : null)"
            aria-disabled="@(_isDownloading ? "true" : null)"
            @onclick="() => DownloadAsync(download)"
        >
            @if (_isDownloading)
            {
                <svg class="ds-spinner" role="img" aria-label="Lager filen" viewBox="0 0 50 50" data-size="sm">
                    <circle class="ds-spinner__background" cx="25" cy="25" r="20" fill="none" stroke-width="5"></circle>
                    <circle class="ds-spinner__circle" cx="25" cy="25" r="20" fill="none" stroke-width="5"></circle>
                </svg>
                <text>Lager filen…</text>
            }
            else
            {
                <span class="material-symbols-outlined" aria-hidden="true">download</span>
                <text>Last ned @download.FileName</text>
            }
        </button>
        @if (_downloadProblem is not null)
        {
            <p class="ds-alert ds-paragraph chat-tool-download-problem" data-size="xs" data-color="warning" role="alert">@_downloadProblem</p>
        }
    }
}
