@if (_outcome is ToolOutcome.Running)
{
    <details class="ds-details" inert>
        <summary><span class="text-shimmer">@_title</span></summary>
    </details>
}
else
{
    <details class="ds-details" data-color="@OutcomeColor">
        <summary>@_title</summary>
        <div>
            <p>Verktøy: <code>@Segment.ToolName</code></p>
            <p>Sendt til verktøyet</p>
            <pre class="chat-tool-output">@_arguments</pre>
            @if (_result is not null)
            {
                <p>Svar fra verktøyet</p>
                <pre class="chat-tool-output">@_result</pre>
            }
        </div>
    </details>
}
