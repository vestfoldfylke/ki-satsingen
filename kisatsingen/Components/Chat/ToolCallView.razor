@using kisatsingen.Services.Chat

@* Functional markup only. Style hooks: .chat-tool, and data-status for the
   state (running | completed | failed | interrupted). *@
<div class="chat-tool" data-status="@StatusName">
    <span class="chat-tool-name">@Segment.ToolName</span>
    <span class="chat-tool-status">@StatusText</span>
    <details class="chat-tool-details">
        <summary>Detaljer</summary>
        <pre class="chat-tool-arguments">@_arguments</pre>
        @if (_result is not null)
        {
            <pre class="chat-tool-result">@_result</pre>
        }
    </details>
</div>
