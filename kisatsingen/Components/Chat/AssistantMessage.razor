@using Microsoft.Extensions.AI
@using Microsoft.JSInterop
@using kisatsingen.Services.Chat
@inject IJSRuntime JS

<div class="assistant-message">
    @if (!string.IsNullOrEmpty(Message.Text))
    {
        <div class="assistant-markdown" @ref="_markdownElement"></div>
        <div class="markdown-fallback">@Message.Text</div>
    }

    @foreach (var content in Message.Contents)
    {
        switch (content)
        {
            case FunctionCallContent call:
                <ToolCallBlock Call="call" />
                break;
            case FunctionResultContent result:
                <ToolResultBlock Result="result" />
                break;
        }
    }
</div>

@code {
    [Parameter, EditorRequired] public required ChatMessageView Message { get; set; }

    private ElementReference _markdownElement;
    private string? _lastRendered;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (string.IsNullOrEmpty(Message.Text) || Message.Text == _lastRendered)
        {
            return;
        }

        try
        {
            await JS.InvokeVoidAsync("chatClient.renderMarkdown", _markdownElement, Message.Text);
            _lastRendered = Message.Text;
        }
        catch
        {
            // JS interop failed; the .markdown-fallback sibling stays visible.
        }
    }
}
