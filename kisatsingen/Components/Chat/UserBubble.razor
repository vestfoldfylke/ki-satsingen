@using kisatsingen.Services.Chat

<div class="user-bubble">
    @* What was sent only: what became of each file is the assistant turn's. *@
    @if (Attachments.Count > 0)
    {
        <ul class="user-bubble-attachments" aria-label="Vedlegg">
            @foreach (var attachment in Attachments)
            {
                <li class="ds-paragraph user-bubble-attachment" data-size="xs">
                    <span class="material-symbols-outlined" aria-hidden="true">attach_file</span>
                    <span class="user-bubble-attachment-name" title="@attachment.FileName">@attachment.FileName</span>
                </li>
            }
        </ul>
    }
    <div class="user-bubble-prompt">@Prompt</div>
</div>

@code {
    [Parameter, EditorRequired] public required string Prompt { get; set; }

    [Parameter] public IReadOnlyList<TurnAttachment> Attachments { get; set; } = [];
}
