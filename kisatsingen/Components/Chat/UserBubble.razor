@using kisatsingen.Services.Chat

<div class="user-bubble">
    <div class="user-bubble-prompt">@Prompt</div>
    @if (Attachments.Count > 0)
    {
        <ul aria-label="Vedlegg">
            @foreach (var attachment in Attachments)
            {
                <li>
                    @attachment.FileName
                    @if (DescribeStatus(attachment) is { } status)
                    {
                        <span data-color="@(attachment.UnavailableReason is not null ? "danger" : null)">@status</span>
                    }
                </li>
            }
        </ul>
    }
</div>

@code {
    [Parameter, EditorRequired] public required string Prompt { get; set; }

    [Parameter] public IReadOnlyList<TurnAttachment> Attachments { get; set; } = [];

    // Null when available: the file's name alone says it is there.
    private static string? DescribeStatus(TurnAttachment attachment) => attachment switch
    {
        { IsProcessing: true } => "Behandles",
        { UnavailableReason: { } reason } => reason,
        _ => null
    };
}
