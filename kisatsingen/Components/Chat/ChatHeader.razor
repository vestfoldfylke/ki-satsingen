<header class="chat-header">
    <h1 class="ds-heading chat-header-title" data-size="2xs">
        @if (AssistantName is string assistantName)
        {
            if (AssistantId is Guid assistantId)
            {
                <a class="ds-link assistant-link" href="/assistants/@assistantId">@assistantName</a>
            }
            else
            {
                @assistantName
            }
            <span aria-hidden="true"> / </span>
        }
        @(Title ?? UntitledChat)
    </h1>

    <button type="button"
            class="ds-button chat-header-files"
            data-variant="@(IsFilesPanelOpen ? "secondary" : "tertiary")"
            aria-controls="chat-files-panel"
            aria-expanded="@(IsFilesPanelOpen ? "true" : "false")"
            @onclick="OnToggleFiles">
        <span class="material-symbols-outlined" aria-hidden="true">folder</span>
        Filer@(FileCount > 0 ? $" ({FileCount})" : null)
    </button>
</header>

@code {
    private const string UntitledChat = "Samtale";

    // Null for a chat that has no title yet.
    [Parameter]
    public string? Title { get; set; }

    // Null for a chat without an assistant, which shows nothing.
    [Parameter]
    public string? AssistantName { get; set; }

    // Null when the assistant can't be opened; the name then shows without a link.
    [Parameter]
    public Guid? AssistantId { get; set; }

    [Parameter]
    public int FileCount { get; set; }

    [Parameter]
    public bool IsFilesPanelOpen { get; set; }

    [Parameter]
    public EventCallback OnToggleFiles { get; set; }
}
