<div class="chat-composer-container">
    @* Keeps the always-present live region out of the container's flex gap,
       which would otherwise add empty space above the composer. *@
    <div>
        @* The live region must exist before its content does, or screen readers
           miss the first notice. *@
        <div aria-live="polite">
            @if (Notice is { } notice)
            {
                <p class="ds-alert ds-paragraph composer-notice" data-size="sm" data-color="@notice.Color">
                    @notice.Text
                </p>
            }
        </div>

        <div class="chat-composer">
            @* In view at every send while search is on, so the user knows where
               search queries go before sending. *@
            @if (Session.IsWebSearchOn)
            {
                <p class="ds-alert ds-paragraph" data-size="xs">Nettsøk er på. Søkeord sendes til OpenAI, så ikke skriv personopplysninger i denne chatten.</p>
            }

            <ComposerAttachments Attachments="Attachments.All"
                                 Notice="@Attachments.SelectionNotice"
                                 OnRemove="Attachments.Remove" />

            @* The way in for pasted and dropped files. A new one for each chat,
               so files added in one chat never attach to the next when switching
               chat. *@
            <InputFile @key="Session.ChatId" id="composer-file-input" hidden OnChange="AttachQueuedFilesAsync" />
            @* Static, so Blazor never touches the text composer-paste.ts writes. *@
            <div id="composer-paste-announcement" class="visually-hidden" aria-live="polite"></div>
            <ComposerDropZone />

            <textarea @ref="_textarea"
                      id="chat-textarea"
                      class="ds-input chat-textarea"
                      placeholder="Spør om hva som helst..."></textarea>

            <div class="chat-composer-actions">
                <div class="composer-actions-left">
                    <ComposerAddMenu IsFilePickerDisabled="IsPickerDisabled"
                                     OnFilesSelected="Attachments.AttachAsync"
                                     IsWebSearchAvailable="Session.IsWebSearchAvailable"
                                     IsWebSearchOn="Session.IsWebSearchOn"
                                     OnWebSearchChanged="Session.SetWebSearch"
                                     IsBusy="Session.IsBusy" />

                    @if (Session.EstimatedContextTokens is { } contextTokens)
                    {
                        <ContextUsagePopover Model="Session.SelectedModel"
                                             EstimatedContextTokens="contextTokens"
                                             Usage="Session.ConversationUsage" />
                    }

                    @* One model is no choice, so no picker. *@
                    @if (Session.AvailableModels.Count > 1)
                    {
                        <ModelPicker Models="Session.AvailableModels"
                                     Selected="Session.SelectedModel"
                                     OnSelect="Session.SelectModelAsync"
                                     IsBusy="Session.IsBusy"
                                     EstimatedContextTokens="Session.EstimatedContextTokens" />
                    }
                </div>

                <div class="composer-actions-right">
                    @* Stop is Blazor's: IsBusy is its only input. Send is JS's, because its
                    disabled state also depends on the textarea being empty. *@
                    @if (Session.IsBusy)
                    {
                        <button id="composer-stop-button"
                                class="ds-button"
                                type="button"
                                data-variant="secondary"
                                data-color="neutral"
                                data-icon="true"
                                aria-label="Stopp generering"
                                data-tooltip="Stopp generering"
                                @onclick="Session.Cancel">
                            <span class="material-symbols-outlined" aria-hidden="true">stop</span>
                        </button>
                    }
                    @* Static: right for an empty textarea, and chat-composer.ts owns it
                    after that. Blazor must never re-render it. *@
                    <button id="composer-send-button"
                            class="ds-button"
                            data-variant="primary"
                            data-icon="true"
                            type="button"
                            aria-label="Send melding"
                            data-tooltip="Send melding"
                            disabled
                            @onclick="SendAsync">
                        <span class="material-symbols-outlined" aria-hidden="true">arrow_upward</span>
                    </button>
                </div>
            </div>
        </div>
    </div>

    <p class="ds-paragraph chat-footer" data-size="xs" data-color="neutral">KI kan gjøre feil. Vurder alltid svarene kritisk.</p>
</div>
