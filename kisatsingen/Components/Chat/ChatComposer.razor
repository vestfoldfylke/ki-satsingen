<div class="chat-composer">
    <textarea @ref="_textarea"
              id="chat-textarea"
              class="ds-input chat-textarea"
              placeholder="Spør om hva som helst..."
              disabled="@IsBusy"></textarea>

    <div class="chat-composer-actions">
        <div class="composer-actions-left">
            <button class="composer-icon-button" type="button" aria-label="Legg ved fil" disabled="@IsBusy">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="12" y1="5" x2="12" y2="19"/>
                    <line x1="5" y1="12" x2="19" y2="12"/>
                </svg>
            </button>
            @* Absent until the catalogue has been read. One model means no choice
               to offer, so the control is not worth the row space. *@
            @if (Models.Count > 1 && SelectedModel is not null)
            {
                <ModelPicker Models="Models"
                             Selected="SelectedModel"
                             OnSelect="OnSelectModel"
                             IsBusy="IsBusy"
                             EstimatedContextTokens="EstimatedContextTokens" />
            }
            @* The only feedback a switch produces until a turn runs on it. Stated
               as what will happen rather than what was clicked, so it stays true
               for as long as it is shown — and disappears by becoming a boundary
               in the transcript once the next answer arrives.

               aria-live because nothing else announces the change: the picker's
               own label updates silently. *@
            @* The warning outranks the pending line: both concern the next answer,
               and one of them says it may not arrive. *@
            @if (SelectedModel?.WouldOverflow(EstimatedContextTokens) == true)
            {
                <p class="composer-context-warning" aria-live="polite">
                    Samtalen er trolig for lang for @SelectedModel.DisplayName. Svaret kan feile.
                </p>
            }
            else if (PendingModel is { } pending)
            {
                <p class="composer-pending-model" aria-live="polite">Neste svar: @pending.DisplayName</p>
            }
        </div>
        <div class="composer-actions-right">
            @* Stop is Blazor-owned: its only signal is IsBusy, which the server
               already knows. Send is JS-owned because its disabled state also
               depends on textarea emptiness — a client-only signal. *@
            @if (IsBusy)
            {
                <button class="composer-stop-button"
                        type="button"
                        aria-label="Stopp generering"
                        @onclick="OnStop">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                        <rect x="6" y="6" width="12" height="12" rx="1"/>
                    </svg>
                </button>
            }
            @* disabled is static: the textarea always starts empty, so this is
               the correct initial state. chat-composer.ts owns it from here on
               (busy + emptiness combined) — Blazor never re-touches it. *@
            <button class="composer-send-button"
                    type="button"
                    aria-label="Send melding"
                    disabled
                    @onclick="OnSend">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="12" y1="19" x2="12" y2="5"/>
                    <polyline points="5 12 12 5 19 12"/>
                </svg>
            </button>
        </div>
    </div>
</div>

<p class="ds-paragraph chat-footer">Claude kan gjøre feil (ikke vi). Sjekk viktige svar.</p>
