@using kisatsingen.Services.Chat

<div class="assistant-turn" data-live="@IsLive">
    @foreach (var segment in Turn.Answer)
    {
        switch (segment)
        {
            case TextSegment text:
                <TextSegmentView @key="text.Id" Segment="text" IsStreaming="text.Id == StreamingSegmentId" />
                break;
            case ToolSegment tool:
                <ToolCallView @key="tool.Id" Segment="tool" />
                break;
        }
    }

    @if (!IsLive)
    {
        <footer class="assistant-turn-footer" data-color="neutral">
            <div class="assistant-turn-actions">
                @if (HasCopyableText)
                {
                    <button class="ds-button assistant-turn-action-button"
                            data-icon="true"
                            type="button"
                            data-variant="tertiary"
                            data-size="sm"
                            data-copy-turn-id="@Turn.Id"
                            aria-label="Kopier"
                            data-tooltip="Kopier"
                    >
                        <span class="material-symbols-outlined icon-copy-confirm" aria-hidden="true">check</span>
                        <span class="material-symbols-outlined icon-copy" aria-hidden="true">content_copy</span>
                    </button>
                }

                <button class="ds-button assistant-turn-action-button"
                        data-icon="true"
                        type="button"
                        data-variant="tertiary"
                        data-size="sm"
                        data-tooltip="Detaljer"
                        aria-label="Detaljer"
                        aria-controls="@PopoverId"
                        popovertarget="@PopoverId"
                >
                    <span class="material-symbols-outlined" aria-hidden="true">info</span>
                </button>

                <button class="ds-button assistant-turn-action-button"
                        data-icon="true"
                        type="button"
                        data-variant="tertiary"
                        data-size="sm"
                        aria-label="Instruksjoner"
                        data-tooltip="Instruksjoner"
                        command="show-modal"
                        commandfor="@InstructionsDialogId"
                >
                    <span class="material-symbols-outlined" aria-hidden="true">description</span>
                </button>
            </div>

            <time
                class="assistant-turn-time"
                datetime="@Turn.StartedAt.ToString("o")"
            >
                @TimeZoneInfo.ConvertTime(Turn.StartedAt, Oslo).ToString("d. MMM HH:mm")
            </time>
        </footer>

        <ModalDialog Id="@InstructionsDialogId" Heading="Instruksjoner for dette svaret">
            <div class="assistant-turn-instructions">@Instructions</div>
        </ModalDialog>

        <div id="@PopoverId"
            class="ds-popover assistant-metadata"
            popover="auto"
            data-placement="top"
            data-color="neutral"
        >
            <p class="ds-paragraph assistant-metadata-heading" data-size="sm"><strong>Detaljer for melding</strong></p>
            <dl class="assistant-metadata-list assistant-metadata-list-stacked">
                @if (DescribeModel(Turn) is { } modelDescription)
                {
                    <dt>Språkmodell</dt>
                    <dd>@modelDescription</dd>
                }
                @if (Turn.Metadata?.ResponseId is { } responseId)
                {
                    <dt>Respons ID</dt>
                    <dd>@responseId</dd>
                }
            </dl>
            <dl class="assistant-metadata-list">
                @if (Turn.Metadata is { } meta)
                {
                    @if (meta.FinishReason is { } finish)
                    {
                        <dt>Årsak til svarslutt</dt>
                        <dd>@finish</dd>
                    }
                    @if (meta.DurationMs is { } duration)
                    {
                        <dt>Varighet</dt>
                        <dd>@FormatMs(duration)</dd>
                    }
                    @if (meta.TimeToFirstTokenMs is { } ttft)
                    {
                        <dt>Tid før svaret startet</dt>
                        <dd>@FormatMs(ttft)</dd>
                    }
                }
            </dl>

            @if (Turn.Metadata?.Usage is { } usage)
            {
                <hr aria-hidden="true" class="ds-divider"/>

                <p class="ds-paragraph assistant-metadata-heading" data-size="sm"><strong>Tokenbruk</strong></p>
                <dl class="assistant-metadata-list">
                    @if (usage.CombinedInputTokens is { } input)
                    {
                        <dt>Sendt til KI</dt>
                        <dd>@TokenCountFormat.Format(input, usage.IsEstimated)</dd>
                    }
                    @if (usage.CombinedOutputTokens is { } output)
                    {
                        <dt>Svar fra KI</dt>
                        <dd>@TokenCountFormat.Format(output, usage.IsEstimated)</dd>
                    }
                    @if (usage.CombinedTotalTokens is { } total)
                    {
                        <dt>Totalt behandlet</dt>
                        <dd>@TokenCountFormat.Format(total, usage.IsEstimated)</dd>
                    }
                </dl>
            }
        </div>
    }
</div>
