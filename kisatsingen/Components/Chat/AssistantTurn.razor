@using kisatsingen.Services.Chat

<div class="assistant-turn" data-live="@IsLive">
    @foreach (var segment in Turn.Answer)
    {
        switch (segment)
        {
            case TextSegment text:
                <TextSegmentView @key="text.Id" Segment="text" IsStreaming="text.Id == StreamingSegmentId" />
                break;
            case ToolSegment tool:
                <ToolCallView @key="tool.Id" Segment="tool" />
                break;
        }
    }

    @if (!IsLive)
    {
        <footer class="assistant-turn-footer">
            <div class="assistant-turn-actions">
                @if (HasCopyableText)
                {
                    <button type="button"
                            class="ds-button assistant-turn-action-button"
                            data-color="neutral"
                            data-variant="tertiary"
                            data-size="sm"
                            data-copy-turn-id="@Turn.Id"
                            aria-label="Kopier"
                            data-tooltip="Kopier"
                    >
                        <span class="material-symbols-outlined icon-copy-confirm" aria-hidden="true">check</span>
                        <span class="material-symbols-outlined icon-copy" aria-hidden="true">content_copy</span>
                    </button>
                }

                <button type="button"
                        class="ds-button assistant-turn-action-button"
                        data-color="neutral"
                        data-variant="tertiary"
                        data-size="sm"
                        aria-label="Metadata"
                        data-tooltip="Metadata"
                        popovertarget="@PopoverId"
                        aria-controls="@PopoverId"
                >
                    <span class="material-symbols-outlined" aria-hidden="true">info</span>
                </button>
            </div>

            <time class="assistant-turn-time" datetime="@Turn.StartedAt.ToString("o")">
                @Turn.StartedAt.LocalDateTime.ToString("d. MMM HH:mm:ss")
            </time>
        </footer>

        <div id="@PopoverId"
            class="ds-popover assistant-metadata"
            popover="auto"
            data-placement="top"
            data-color="neutral"
            @ontoggle="() => _showFullPrompt = false"
        >
            <div class="assistant-metadata-scroll">
                @if (DescribeModel(Turn) is { } modelDescription)
                {
                    <p class="ds-paragraph" data-size="md"><strong>Detaljer for melding</strong></p>
                    <dl class="assistant-metadata-list">
                        <dt>Språkmodell</dt>
                        <dd>@modelDescription</dd>
                    </dl>
                }

                <hr aria-hidden="true" class="ds-divider"/>

                <p class="ds-paragraph" data-size="sm"><strong>Instruksjoner</strong></p>
                <div class="assistant-metadata-instructions @(_showFullPrompt ? "expanded" : "")">
                    <div @key="_showFullPrompt" class="assistant-metadata-instructions-content">@Turn.SystemPrompt?.TrimStart()</div>
                </div>

                @if (Turn.SystemPrompt?.Length > 160)
                {
                    <button class="ds-button assistant-metadata-toggle"
                            type="button"
                            data-variant="tertiary"
                            data-size="sm"
                            data-color="primary"
                            aria-expanded="@_showFullPrompt" @onclick="() => _showFullPrompt = !_showFullPrompt"
                    >
                        <span class="material-symbols-outlined" aria-hidden="true">@(_showFullPrompt ? "expand_less" : "expand_more")</span>
                        @(_showFullPrompt ? "Vis mindre" : "Vis mer")
                    </button>
                }

                <hr aria-hidden="true" class="ds-divider"/>

                @if (Turn.Metadata is { } meta)
                {
                    <p class="ds-paragraph" data-size="sm"><strong>Detaljer</strong></p>
                    <dl class="assistant-metadata-list">
                        @if (meta.ResponseId is { } responseId)
                        {
                            <dt>Respons ID</dt>
                            <dd>@responseId</dd>
                        }
                        @if (meta.FinishReason is { } finish)
                        {
                            <dt>Årsak til svarslutt</dt>
                            <dd>@finish</dd>
                        }

                        @if (meta.DurationMs is { } duration)
                        {
                            <dt>Varighet</dt>
                            <dd>@FormatMs(duration)</dd>
                        }
                        @if (meta.TimeToFirstTokenMs is { } ttft)
                        {
                            <dt>Tid før svaret startet</dt>
                            <dd>@FormatMs(ttft)</dd>
                        }
                    </dl>

                    <hr aria-hidden="true" class="ds-divider"/>

                    <p class="ds-paragraph" data-size="sm"><strong>Tokenbruk</strong></p>
                    <dl class="assistant-metadata-list">
                        @if (meta.Usage is { } usage)
                        {
                            @if (usage.CombinedInputTokens is { } input)
                            {
                                <dt>Sendt til KI</dt>
                                <dd>@TokenCountFormat.Format(input, usage.IsEstimated)</dd>
                            }
                            @if (usage.CombinedOutputTokens is { } output)
                            {
                                <dt>Svar fra KI</dt>
                                <dd>@TokenCountFormat.Format(output, usage.IsEstimated)</dd>
                            }
                            @if (usage.CombinedTotalTokens is { } total)
                            {
                                <dt>Totalt behandlet</dt>
                                <dd>@TokenCountFormat.Format(total, usage.IsEstimated)</dd>
                            }
                        }
                    </dl>
                }
            </div>
        </div>
    }
</div>
