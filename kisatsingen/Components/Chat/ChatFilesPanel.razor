@using kisatsingen.Components.KnowledgeFiles
@using kisatsingen.Data.Entities

<aside
    id="chat-files-panel"
    class="chat-files-panel"
    data-showing-file="@(_shownFile is not null)"
    aria-label="Filer i samtalen"
>
    <div class="chat-files-panel-header">
        @if (_shownFile is not null)
        {
            <button
                type="button"
                class="ds-button"
                data-variant="tertiary"
                data-icon="true"
                aria-label="Tilbake til filene"
                data-tooltip="Tilbake til filene"
                @onclick="ShowFileList"
            >
                <span class="material-symbols-outlined" aria-hidden="true">arrow_back</span>
            </button>
        }
        <h2 class="ds-heading chat-files-panel-title" data-size="xs">@(_shownFile?.FileName ?? "Filer")</h2>
    </div>

    <div class="chat-files-panel-body">
        @if (_shownFile is { } shownFile)
        {
            <KnowledgeFileViewer @key="shownFile.Id" FileId="shownFile.Id" ReadFileText="ReadFileText" />
        }
        else
        {
            @if (AssistantFiles.Count == 0 && ChatFiles.Count == 0)
            {
                <p class="ds-paragraph" data-size="sm">Filer du sender i samtalen, vises her.</p>
            }

            @if (AssistantFiles.Count > 0)
            {
                <h3 class="ds-heading" data-size="2xs">Fra assistenten</h3>
                @* No delete here: the assistant's files are managed on its page. *@
                <KnowledgeFileList Files="AssistantFiles" OnOpenRequested="ShowFile" />
            }

            @if (ChatFiles.Count > 0)
            {
                <h3 class="ds-heading" data-size="2xs">I samtalen</h3>
                <KnowledgeFileList
                    Files="ChatFiles"
                    OnOpenRequested="ShowFile"
                    DeleteDialogId="@DeleteDialogId"
                    OnDeleteRequested="file => _deleteDialog?.Load(file)"
                />
            }
        }
    </div>

    @* Outside the chat files' section, so deleting the last file doesn't remove
       the dialog while it shows that the file was not found. *@
    <DeleteChatFileDialog @ref="_deleteDialog" Id="@DeleteDialogId" />
</aside>

@code {
    private const string DeleteDialogId = "delete-chat-file-dialog";

    private DeleteChatFileDialog? _deleteDialog;

    // Null while the file list is shown.
    private KnowledgeFileMetadata? _shownFile;

    [Parameter]
    public IReadOnlyList<KnowledgeFileMetadata> AssistantFiles { get; set; } = [];

    [Parameter]
    public IReadOnlyList<KnowledgeFileMetadata> ChatFiles { get; set; } = [];

    [Parameter, EditorRequired]
    public required Func<Guid, CancellationToken, Task<KnowledgeFileText?>> ReadFileText { get; set; }

    private void ShowFile(KnowledgeFileMetadata file) => _shownFile = file;

    private void ShowFileList() => _shownFile = null;
}
