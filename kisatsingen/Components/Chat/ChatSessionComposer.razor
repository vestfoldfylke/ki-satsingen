<ChatComposer @ref="_composer"
              IsBusy="Session.IsBusy"
              OnSend="SendAsync"
              OnStop="Session.Cancel"
              Models="Session.AvailableModels"
              SelectedModel="Session.SelectedModel"
              OnSelectModel="Session.SelectModelAsync"
              EstimatedContextTokens="Session.EstimatedContextTokens"
              ConversationUsage="Session.ConversationUsage"
              Attachments="Attachments.All"
              AttachmentNotice="@Attachments.SelectionNotice"
              IsUploading="Attachments.IsUploading"
              OnFilesSelected="Attachments.AttachAsync"
              OnRemoveAttachment="Attachments.Remove" />
