@using kisatsingen.Services

@* The date as it is in Norway, so a time just after midnight in Oslo would
   otherwise show as the day before. *@
<time class="@Class" datetime="@Value.ToString("o")">@DateTimeService.GetTimeZonedDateTimeOffsetString(Value, DateTimeFormat)</time>

@code {
    [Parameter, EditorRequired]
    public required DateTimeOffset Value { get; set; }

    [Parameter] public string DateTimeFormat { get; set; } = "d. MMM yyyy";

    [Parameter]
    public string? Class { get; set; }
}
