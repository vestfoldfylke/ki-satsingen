@using kisatsingen.Services

@* The date as it is in Norway, not on the server: the server runs in UTC, so a
   time just after midnight in Oslo would otherwise show as the day before. *@
<time datetime="@Value.ToString("o")">@DateTimeService.GetTimeZonedDateTimeOffsetString(Value, "d. MMM yyyy")</time>

@code {
    [Parameter, EditorRequired]
    public required DateTimeOffset Value { get; set; }
}
