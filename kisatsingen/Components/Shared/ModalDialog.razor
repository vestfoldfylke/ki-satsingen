@* Opened by a command="show-modal" button whose commandfor is this Id; there is no Open(). *@
<dialog @key="_key" id="@Id" class="ds-dialog" data-modal="true" data-placement="center">
    <button type="button" class="ds-button" data-icon="true" data-variant="tertiary" data-color="neutral"
            command="close" commandfor="@Id" aria-label="Lukk dialogvindu"></button>

    <div class="ds-dialog__block">
        <h2 class="ds-heading">@Heading</h2>
    </div>

    <div class="ds-dialog__block">
        @ChildContent
    </div>
</dialog>

@code {
    [Parameter, EditorRequired]
    public required string Id { get; set; }

    [Parameter, EditorRequired]
    public required string Heading { get; set; }

    [Parameter, EditorRequired]
    public required RenderFragment ChildContent { get; set; }

    private int _key;

    // Closing a modal <dialog> from code takes its close() method, which only
    // JavaScript can call. A new key makes Blazor replace the element instead,
    // and a new <dialog> starts closed.
    public void Close()
    {
        _key++;
        StateHasChanged();
    }
}
