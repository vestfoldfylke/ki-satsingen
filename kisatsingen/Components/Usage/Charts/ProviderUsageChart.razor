@using kisatsingen.Data.Entities

<div class="usage-chart">
    <h3 class="ds-heading" data-size="xs">Forbruk per leverandør</h3>
    @if (_points.Count == 0)
    {
        <p class="ds-paragraph">Ingen data i perioden.</p>
    }
    else
    {
        <RadzenChart Style="height: 380px;" MouseMoveThrottle="150">
            <RadzenColumnSeries Data="@_points"
                                CategoryProperty="@nameof(ProviderPoint.Provider)"
                                ValueProperty="@nameof(ProviderPoint.InputTokens)"
                                Title="Input tokens" />
            <RadzenColumnSeries Data="@_points"
                                CategoryProperty="@nameof(ProviderPoint.Provider)"
                                ValueProperty="@nameof(ProviderPoint.OutputTokens)"
                                Title="Output tokens" />
            <RadzenColumnSeries Data="@_points"
                                CategoryProperty="@nameof(ProviderPoint.Provider)"
                                ValueProperty="@nameof(ProviderPoint.EstimatedInputTokens)"
                                Title="Estimert input tokens" />
            <RadzenColumnSeries Data="@_points"
                                CategoryProperty="@nameof(ProviderPoint.Provider)"
                                ValueProperty="@nameof(ProviderPoint.EstimatedOutputTokens)"
                                Title="Estimert output tokens" />
            <RadzenCategoryAxis />
            <RadzenValueAxis />
            <RadzenLegend Position="LegendPosition.Bottom" />
        </RadzenChart>
    }
</div>
