@using kisatsingen.Data.Entities

<div class="usage-chart">
    <h3 class="ds-heading" data-size="xs">Forbruk per leverandør</h3>
    @if (Breakdown.Count == 0)
    {
        <p class="ds-paragraph">Ingen data i perioden.</p>
    }
    else
    {
        <ApexChart TItem="UsageByKey<string>" Options="_options">
            <ApexPointSeries TItem="UsageByKey<string>"
                             Items="Breakdown"
                             Name="Input tokens"
                             SeriesType="SeriesType.Bar"
                             XValue="ProviderLabel"
                             YAggregate="e => e.Sum(x => x.InputTokens)" />
            <ApexPointSeries TItem="UsageByKey<string>"
                             Items="Breakdown"
                             Name="Output tokens"
                             SeriesType="SeriesType.Bar"
                             XValue="ProviderLabel"
                             YAggregate="e => e.Sum(x => x.OutputTokens)" />
            <ApexPointSeries TItem="UsageByKey<string>"
                             Items="Breakdown"
                             Name="Estimert input tokens"
                             SeriesType="SeriesType.Bar"
                             XValue="ProviderLabel"
                             YAggregate="e => e.Sum(x => x.EstimatedInputTokens)" />
            <ApexPointSeries TItem="UsageByKey<string>"
                             Items="Breakdown"
                             Name="Estimert output tokens"
                             SeriesType="SeriesType.Bar"
                             XValue="ProviderLabel"
                             YAggregate="e => e.Sum(x => x.EstimatedOutputTokens)" />
        </ApexChart>
    }
</div>
