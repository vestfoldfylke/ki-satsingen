@using kisatsingen.Data.Entities
@using kisatsingen.Services.Chat

<div class="usage-chart">
    <h3 class="ds-heading" data-size="xs">Status på turer</h3>
    @if (_points.Count == 0)
    {
        <p class="ds-paragraph">Ingen data i perioden.</p>
    }
    else
    {
        <RadzenChart Style="height: 320px;" MouseMoveThrottle="150">
            <RadzenDonutSeries Data="@_points"
                               CategoryProperty="@nameof(StatusPoint.Status)"
                               ValueProperty="@nameof(StatusPoint.TurnCount)"
                               Title="Antall turer" />
            <RadzenLegend Position="LegendPosition.Bottom" />
        </RadzenChart>
    }
</div>
