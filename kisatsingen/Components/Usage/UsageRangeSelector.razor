<select class="ds-input" @bind="Current" @bind:after="SelectionChanged" aria-label="Velg tidsrom">
    @foreach (var range in Ranges)
    {
        if (range == Current)
        {
            <option value="@range" selected="selected">@range.Label()</option>
            continue;
        }

        <option value="@range">@range.Label()</option>
    }
</select>
