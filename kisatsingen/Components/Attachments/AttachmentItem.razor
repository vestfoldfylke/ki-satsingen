<div class="attachment-item">
    <div class="attachment-item-text">
        <span class="ds-paragraph attachment-item-line" data-size="xs" title="@FileName">@FileName</span>

        @if (Status is AttachmentItemStatus.Failed failed)
        {
            <span class="ds-paragraph attachment-item-detail" data-size="xs" data-color="danger">@failed.Reason</span>
        }
        else
        {
            <span class="attachment-item-detail-row">
                <span class="ds-paragraph attachment-item-line attachment-item-detail" data-size="xs">@TypeAndSize</span>
                @if (TagText is { } tagText)
                {
                    <span class="ds-tag attachment-item-tag" data-color="@TagColor">@tagText</span>
                }
            </span>
        }
    </div>

    @if (OnRemove.HasDelegate)
    {
        <button type="button" class="ds-button attachment-item-remove" data-size="sm" data-variant="tertiary" data-icon="true"
                data-tooltip="@($"Fjern {FileName}")"
                aria-label="@($"Fjern {FileName}")"
                @onclick="OnRemove">
            <span class="material-symbols-outlined" aria-hidden="true">close</span>
        </button>
    }
</div>
