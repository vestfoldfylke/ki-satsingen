@using kisatsingen.Data.Entities

<div class="assistant-details">
    <div class="assistant-details-text">
        <h1 class="ds-heading" data-size="md">@Assistant.Name</h1>
        @if (Assistant.Description is string description)
        {
            <p class="ds-paragraph">@description</p>
        }
        <p class="ds-paragraph assistant-details-visibility" data-size="sm">
            @if (Assistant.Visibility == AssistantVisibility.Private)
            {
                <span class="material-symbols-outlined" aria-hidden="true">lock_person</span>
                <span>Privat</span>
            }
            else
            {
                <span class="material-symbols-outlined" aria-hidden="true">public</span>
                <span>Felles for hele organisasjonen</span>
            }
        </p>
    </div>

    <AuthorizeView Policy="@AuthorizationPolicies.CanEditAssistant" Resource="Assistant" Context="editAuthenticationState">
        <button type="button" class="ds-button" data-variant="tertiary" data-icon="true"
                popovertarget="@MenuId" data-tooltip="Valg for assistenten" aria-label="Valg for assistenten">
            <span class="material-symbols-outlined" aria-hidden="true">more_vert</span>
        </button>
        <div class="ds-dropdown" id="@MenuId" popover data-placement="bottom-end">
            <ul>
                <li>
                    <button type="button" class="ds-button" data-variant="tertiary"
                            command="show-modal" commandfor="@EditDialogId" @onclick="() => _editDialog?.ResetForm()">
                        <span class="material-symbols-outlined" aria-hidden="true">edit</span>
                        Rediger detaljer
                    </button>
                </li>
                <li>
                    <button type="button" class="ds-button" data-variant="tertiary" data-color="danger"
                            command="show-modal" commandfor="@DeleteDialogId">
                        <span class="material-symbols-outlined" aria-hidden="true">delete</span>
                        Slett assistent
                    </button>
                </li>
            </ul>
        </div>

        <EditAssistantDetailsDialog @ref="_editDialog" Id="@EditDialogId" Assistant="Assistant" OnChanged="OnChanged" />
        <DeleteAssistantDialog Id="@DeleteDialogId" Assistant="Assistant" />
    </AuthorizeView>
</div>
