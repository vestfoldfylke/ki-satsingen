@using kisatsingen.Data.Entities

<div class="ds-card" data-color="neutral">
    <div class="ds-card__block">
        <div class="assistant-tools-header">
            <h2 class="ds-heading" data-size="xs">Verktøy</h2>
            <AuthorizeView Policy="@AuthorizationPolicies.CanEditAssistant" Resource="Assistant" Context="editAuthenticationState">
                <button type="button" class="ds-button" data-variant="tertiary" data-icon="true"
                        command="show-modal" commandfor="@DialogId" @onclick="OpenDialog"
                        data-tooltip="Rediger verktøy" aria-label="Rediger verktøy">
                    <span class="material-symbols-outlined" aria-hidden="true">edit</span>
                </button>
            </AuthorizeView>
        </div>

        <dl class="ds-paragraph assistant-tools-list">
            <dt>Lage dokumenter</dt>
            <dd>
                <span class="ds-tag" data-color="@ChooseSettingColor(Assistant.IsFileGenerationEnabled)" data-size="sm">@DescribeSetting(Assistant.IsFileGenerationEnabled)</span>
            </dd>
            @if (IsWebSearchAvailable)
            {
                <dt>Nettsøk</dt>
                <dd>
                    <span class="ds-tag" data-color="@ChooseSettingColor(Assistant.IsWebSearchEnabled)" data-size="sm">@DescribeSetting(Assistant.IsWebSearchEnabled)</span>
                </dd>
            }
        </dl>
    </div>
</div>

@* The dialog outside the AuthorizeView, so re-checking the policy when the
   assistant reloads never removes an open dialog and its unsaved choices. *@
<ModalDialog @ref="_dialog" Id="@DialogId" Heading="Verktøy">
    @if (_isNotFound)
    {
        <p class="ds-paragraph">Fant ikke assistenten. Den er slettet, eller du har ikke lenger tilgang til den.</p>
    }
    else
    {
        <AuthorizeView Policy="@AuthorizationPolicies.CanEditAssistant" Resource="Assistant" Context="editAuthenticationState">
            <Authorized>
                <EditForm Model="Form" OnValidSubmit="SaveAsync" Context="editContext" class="form-fields">
                    @if (_refusal is not null)
                    {
                        <div class="ds-alert" data-color="danger" role="alert">
                            <p class="ds-paragraph">@_refusal</p>
                        </div>
                    }

                    <ds-field class="ds-field">
                        <InputCheckbox class="ds-input" @bind-Value="Form.IsFileGenerationEnabled" />
                        <label class="ds-label" data-weight="regular">Lage dokumenter</label>
                        <div data-field="description">Lar assistenten lage Word-dokumenter og presentasjoner.</div>
                    </ds-field>

                    @if (IsWebSearchAvailable)
                    {
                        <ds-field class="ds-field">
                            <InputCheckbox class="ds-input" @bind-Value="Form.IsWebSearchEnabled" />
                            <label class="ds-label" data-weight="regular">Nettsøk</label>
                            <div data-field="description">Lar assistenten søke på nettet når svaret trenger det.</div>
                        </ds-field>
                    }

                    @if (Assistant.Visibility == AssistantVisibility.Organization)
                    {
                        <p class="ds-paragraph" data-size="sm">Gjelder alle som bruker assistenten.</p>
                    }

                    <div class="form-actions">
                        <button type="submit" class="ds-button" data-variant="primary">Lagre</button>
                        <button type="button" class="ds-button" data-variant="secondary" command="close" commandfor="@DialogId">Avbryt</button>
                    </div>
                </EditForm>
            </Authorized>
            <NotAuthorized>
                <p class="ds-paragraph">Du har ikke lenger tilgang til å redigere denne assistenten.</p>
            </NotAuthorized>
        </AuthorizeView>
    }
</ModalDialog>
