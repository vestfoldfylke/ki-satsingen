@using kisatsingen.Data.Entities
@using kisatsingen.Services.Chat

<div class="ds-card" data-color="neutral">
    <div class="ds-card__block">
        <div class="assistant-instructions-header">
            <h2 class="ds-heading" data-size="xs">Instruksjoner</h2>
            <AuthorizeView Policy="@AuthorizationPolicies.CanEditAssistant" Resource="Assistant" Context="editAuthenticationState">
                <Authorized>
                    <button type="button" class="ds-button" data-variant="tertiary" data-icon="true"
                            command="show-modal" commandfor="@DialogId" @onclick="OpenDialog"
                            data-tooltip="Rediger instruksjoner" aria-label="Rediger instruksjoner">
                        <span class="material-symbols-outlined" aria-hidden="true">edit</span>
                    </button>
                </Authorized>
                <NotAuthorized>
                    <button type="button" class="ds-button" data-variant="tertiary" data-icon="true"
                            command="show-modal" commandfor="@DialogId" @onclick="OpenDialog"
                            data-tooltip="Vis alle instruksjonene" aria-label="Vis alle instruksjonene">
                        <span class="material-symbols-outlined" aria-hidden="true">open_in_full</span>
                    </button>
                </NotAuthorized>
            </AuthorizeView>
        </div>

        @if (Assistant.Instructions is string instructions)
        {
            <p class="ds-paragraph assistant-instructions-preview">@instructions</p>
        }
        else
        {
            <p class="ds-paragraph">Ingen instruksjoner ennå.</p>
        }
    </div>
</div>

<ModalDialog @ref="_dialog" Id="@DialogId" Heading="Instruksjoner">
    @if (_isNotFound)
    {
        <p class="ds-paragraph">Fant ikke assistenten. Den er slettet, eller du har ikke lenger tilgang til den.</p>
    }
    else
    {
        <AuthorizeView Policy="@AuthorizationPolicies.CanEditAssistant" Resource="Assistant" Context="editAuthenticationState">
            <Authorized>
                <EditForm Model="Form" OnValidSubmit="SaveAsync" Context="editContext" class="form-fields">
                    <DataAnnotationsValidator />

                    @if (_refusal is not null)
                    {
                        <div class="ds-alert" data-color="danger" role="alert">
                            <p class="ds-paragraph">@_refusal</p>
                        </div>
                    }

                    <ds-field class="ds-field">
                        <label class="ds-label">Hva skal assistenten gjøre, og hvordan?</label>
                        <div data-field="description">
                            Assistenten følger også vfKIs
                            <button type="button" data-popover="inline" popovertarget="@BaseInstructionsPopoverId">grunninstruksjoner</button>.
                        </div>
                        <InputTextArea class="ds-input" rows="16" @bind-Value="Form.Instructions" maxlength="@Assistant.MaxInstructionsLength" autofocus />
                        <DesignsystemetValidationMessage For="() => Form.Instructions" />
                    </ds-field>

                    <div class="form-actions">
                        <button type="submit" class="ds-button" data-variant="primary">Lagre</button>
                        <button type="button" class="ds-button" data-variant="secondary" command="close" commandfor="@DialogId">Avbryt</button>
                    </div>
                </EditForm>
            </Authorized>
            <NotAuthorized>
                @if (Assistant.Instructions is string instructions)
                {
                    <p class="ds-paragraph assistant-instructions">@instructions</p>
                }
                else
                {
                    <p class="ds-paragraph">Ingen instruksjoner ennå.</p>
                }

                <hr aria-hidden="true" class="ds-divider"/>

                <p class="ds-paragraph">
                    Assistenten følger også vfKIs
                    <button type="button" data-popover="inline" popovertarget="@BaseInstructionsPopoverId">grunninstruksjoner</button>.
                </p>
            </NotAuthorized>
        </AuthorizeView>

        <div id="@BaseInstructionsPopoverId" class="ds-popover base-instructions-popover" popover="auto" data-placement="bottom" data-color="neutral">
            <p class="ds-paragraph" data-size="sm">
                <strong>Grunninstruksjoner</strong>
            </p>
            <p class="ds-paragraph assistant-instructions" data-size="sm">@ChatInstructions.Base</p>
        </div>
    }
</ModalDialog>
