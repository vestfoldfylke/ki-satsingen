@page "/Administration/Usage"
@using System.Globalization
@using kisatsingen.Components.Usage
@using kisatsingen.Data.Entities

<h3>Total token usage</h3>
<TotalUsage
    TotalInputTokenUsage="TotalInputTokenUsage"
    TotalOutputTokenUsage="TotalOutputTokenUsage"
    TotalEstimatedInputTokenUsage="TotalEstimatedInputTokenUsage"
    TotalEstimatedOutputTokenUsage="TotalEstimatedOutputTokenUsage" />

<h3>Top @TopUserCount users by</h3>
<ds-tabs class="ds-tabs">
    <ds-tablist>
        <ds-tab aria-controls="input-tokens" aria-selected="true" role="tab">Input tokens</ds-tab>
        <ds-tab aria-controls="output-tokens" role="tab">Output tokens</ds-tab>
        <ds-tab aria-controls="estimated-input-tokens" role="tab">Estimated input tokens</ds-tab>
        <ds-tab aria-controls="estimated-output-tokens" role="tab">Estimated output tokens</ds-tab>
    </ds-tablist>
    <ds-tabpanel id="input-tokens">
        @TopTokenUsage(TopTokenUsageByInputTokens)
    </ds-tabpanel>
    <ds-tabpanel id="output-tokens">
        @TopTokenUsage(TopTokenUsageByOutputTokens)
    </ds-tabpanel>
    <ds-tabpanel id="estimated-input-tokens">
        @TopTokenUsage(TopTokenUsageByEstimatedInputTokens)
    </ds-tabpanel>
    <ds-tabpanel id="estimated-output-tokens">
        @TopTokenUsage(TopTokenUsageByEstimatedOutputTokens)
    </ds-tabpanel>
</ds-tabs>

<h3>Usage by Model</h3>
<table class="ds-table">
    <thead>
    <tr>
        <th>DisplayName</th>
        <th>Provider</th>
        <th>ModelId</th>
        <th>Input tokens</th>
        <th>Output tokens</th>
        <th>Estimated input tokens</th>
        <th>Estimated output tokens</th>
        <th>Turns</th>
    </tr>
    </thead>
    <tbody>
    @foreach (var chatModel in ChatModels)
    {
        var tokenUsageSummary = TokenUsageSummaryByModelId(chatModel.ModelId);
        <tr>
            <td>@chatModel.DisplayName</td>
            <td>@chatModel.Provider</td>
            <td>@chatModel.ModelId</td>
            <td>@(tokenUsageSummary.TotalInputTokens.ToString("N0", CultureInfo.InvariantCulture))</td>
            <td>@(tokenUsageSummary.TotalOutputTokens.ToString("N0", CultureInfo.InvariantCulture))</td>
            <td>@(tokenUsageSummary.TotalEstimatedInputTokens.ToString("N0", CultureInfo.InvariantCulture))</td>
            <td>@(tokenUsageSummary.TotalEstimatedOutputTokens.ToString("N0", CultureInfo.InvariantCulture))</td>
            <td>@tokenUsageSummary.TurnCount</td>
        </tr>
    }
    </tbody>
</table>

@code {
    private RenderFragment<IEnumerable<TokenUsage>> TopTokenUsage => topTokenUsage =>
        @<table class="ds-table">
            <thead>
                <tr>
                    <th>OwnerId</th>
                    <th>Input tokens</th>
                    <th>Output tokens</th>
                    <th>Estimated input tokens</th>
                    <th>Estimated output tokens</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var topUserTokenUsage in topTokenUsage)
                {
                    <tr>
                        <td>@topUserTokenUsage.OwnerId</td>
                        <td>@(topUserTokenUsage.InputTokens?.ToString("N0", CultureInfo.InvariantCulture) ?? null)</td>
                        <td>@(topUserTokenUsage.OutputTokens?.ToString("N0", CultureInfo.InvariantCulture) ?? null)</td>
                        <td>@(topUserTokenUsage.EstimatedInputTokens?.ToString("N0", CultureInfo.InvariantCulture) ?? null)</td>
                        <td>@(topUserTokenUsage.EstimatedOutputTokens?.ToString("N0", CultureInfo.InvariantCulture) ?? null)</td>
                    </tr>
                }
            </tbody>
        </table>;
}