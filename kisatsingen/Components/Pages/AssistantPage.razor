@page "/assistants/{AssistantId:guid}"
@using kisatsingen.Components.Assistants
@using kisatsingen.Components.Chat
@attribute [Authorize]

<PageTitle>@(_assistant?.Name ?? "Assistent")</PageTitle>

<div class="assistant-page">
    @if (_isLoading)
    {
        <p class="ds-paragraph">Laster …</p>
    }
    else if (_assistant is null)
    {
        <h1 class="ds-heading" data-size="md">Fant ikke assistenten</h1>
        <p class="ds-paragraph">Den er slettet, eller du har ikke tilgang til den.</p>
    }
    else
    {
        <AssistantDetails Assistant="_assistant" OnChanged="ApplyChangeAsync" />
        <div class="assistant-body">
            <div class="assistant-chat">
                <ChatComposer OnSending="OpenChat" />
            </div>
            <div class="assistant-config">
                <AssistantInstructionsCard Assistant="_assistant" OnChanged="ApplyChangeAsync" />
                @* A new card per assistant: moving to another one disposes the
                   card, which cancels its uploads. *@
                <AssistantKnowledgeFilesCard @key="_assistant.Id" Assistant="_assistant" Files="_files" OnChanged="ApplyChangeAsync" />
            </div>
        </div>
    }
</div>
