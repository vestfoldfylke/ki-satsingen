@page "/chat"
@page "/chat/{ChatId:guid?}"
@rendermode InteractiveServer
@using kisatsingen.Components.Chat
@using kisatsingen.Services.Chat

<PageTitle>Chat</PageTitle>

<div class="chat-layout">
    <aside class="chat-sidebar" aria-label="Chat list">
        <div class="chat-sidebar-header">
            <h2 class="ds-heading" data-size="sm">Chats</h2>
            <button type="button" class="ds-button" @onclick="StartNewChatAsync" disabled="@Session.IsBusy">New</button>
        </div>
        @if (ChatList.Count == 0)
        {
            <p class="ds-paragraph chat-sidebar-empty">No chats yet.</p>
        }
        else
        {
            <ul class="ds-list chat-sidebar-list">
                @foreach (var summary in ChatList)
                {
                    <li>
                        <a class="ds-link chat-sidebar-item @(summary.Id == Session.ChatId ? "chat-sidebar-item-active" : null)"
                           href="@($"/chat/{summary.Id}")">
                            <span class="chat-sidebar-title">@summary.Title</span>
                            <span class="chat-sidebar-time">@summary.UpdatedAt.LocalDateTime.ToString("dd/MM/yy HH:mm:ss")</span>
                        </a>
                    </li>
                }
            </ul>
        }
    </aside>

    <div class="chat-page">
        @if (Session.HasVisibleMessages)
        {
            <div class="chat-log" role="log" aria-live="polite">
                <div class="chat-log-inner">
                    @foreach (var item in Session.Committed)
                    {
                        if (item is UserBubbleView bubble)
                        {
                            <UserBubble @key="item.Id" Bubble="bubble" />
                        }
                        else if (item is AssistantTurnView turn)
                        {
                            <AssistantTurn @key="item.Id" Turn="turn" />
                        }
                    }
                    @if (Session.StreamingId is Guid streamingId)
                    {
                        <StreamingChatMessage Id="streamingId" />
                    }
                    <div class="chat-log-spacer" aria-hidden="true"></div>
                    <button type="button" class="chat-jump-latest" hidden aria-label="Jump to latest">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <line x1="12" y1="5" x2="12" y2="19"/>
                            <polyline points="19 12 12 19 5 12"/>
                        </svg>
                    </button>
                </div>
            </div>
        }
        else
        {
            <div class="chat-greeting-wrapper">
                <div class="chat-greeting">
                    <span class="chat-greeting-emoji">🖕</span>
                    <h1 class="chat-greeting-text">Skjer a din pikk!</h1>
                </div>
            </div>
        }

        <div class="chat-tail">
            @if (Session.ConversationUsage is { } totalUsage)
            {
                <div class="chat-usage-total" aria-label="Total token usage for this conversation">
                    @if (totalUsage.InputTokens is { } input)
                    {
                        <span>in @input.ToString("N0")</span>
                    }
                    @if (totalUsage.OutputTokens is { } output)
                    {
                        <span>out @output.ToString("N0")</span>
                    }
                    @if (totalUsage.TotalTokens is { } total)
                    {
                        <span>total @total.ToString("N0")</span>
                    }
                </div>
            }

            <div class="chat-composer">
                <textarea id="chat-textarea"
                          class="ds-textfield chat-textarea"
                          placeholder="Spør om hva som helst..."
                          rows="1"
                          disabled="@Session.IsBusy"
                          @bind="MessageText"
                          @bind:event="oninput"
                          @onkeydown="OnComposerKeyDownAsync"></textarea>

                <div class="chat-composer-actions">
                    <button class="composer-icon-button" type="button" aria-label="Legg ved fil" disabled="@Session.IsBusy">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <line x1="12" y1="5" x2="12" y2="19"/>
                            <line x1="5" y1="12" x2="19" y2="12"/>
                        </svg>
                    </button>
                    <button class="composer-send-button"
                            type="button"
                            aria-label="Send melding"
                            disabled="@(Session.IsBusy || string.IsNullOrWhiteSpace(MessageText))"
                            @onclick="SendAsync">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                            <line x1="12" y1="19" x2="12" y2="5"/>
                            <polyline points="5 12 12 5 19 12"/>
                        </svg>
                    </button>
                </div>
            </div>

            <p class="ds-paragraph chat-footer">Claude kan gjøre feil (ikke vi). Sjekk viktige svar.</p>
        </div>
    </div>
</div>
