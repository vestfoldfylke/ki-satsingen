@page "/chat/{ChatId:guid}"
@using kisatsingen.Components.Chat

@if (Session.IsChatNotFound)
{
    <PageTitle>Fant ikke samtalen</PageTitle>

    <div class="page-padded">
        <h1 class="ds-heading" data-size="md">Fant ikke samtalen</h1>
        <p class="ds-paragraph">Den er slettet, eller du har ikke tilgang til den. Samtaler som ikke er brukt på en stund, slettes automatisk.</p>
        <p class="ds-paragraph"><a class="ds-link" href="/new">Start en ny samtale</a></p>
    </div>
}
else
{
    <PageTitle>@(string.IsNullOrWhiteSpace(Title) ? "Ny chat" : Title)</PageTitle>

    <div class="chat-layout">
        <div class="chat-column">
            <ChatHeader
                Title="@Title"
                AssistantName="@Session.AssistantName"
                AssistantId="Session.AssistantId"
                FileCount="Session.AssistantFiles.Count + Session.ChatFiles.Count"
                IsFilesPanelOpen="_isFilesPanelOpen"
                OnToggleFilesPanel="ToggleFilesPanel"
            />

            <div class="chat-page">
                <div class="chat-log" role="log" aria-live="polite">
                    <div class="chat-log-inner">
                        @foreach (var view in Session.Transcript)
                        {
                            <TranscriptTurn @key="view.Turn.Id" View="view" />
                        }
                        @if (Session.HasLiveTurn)
                        {
                            @* The spacer rule and chat-scroll.ts key off this: its
                               removal is how the page learns the turn has ended. *@
                            <div class="assistant-streaming" aria-hidden="true"></div>
                        }
                        <div class="chat-log-spacer" aria-hidden="true"></div>
                        <button type="button"
                                class="ds-button chat-jump-latest"
                                data-variant="secondary"
                                data-color="neutral"
                                data-size="sm"
                                data-icon="true"
                                hidden
                                aria-label="Gå til nyeste melding"
                                data-tooltip="Gå til nyeste melding">
                            <span class="material-symbols-outlined" aria-hidden="true">arrow_downward</span>
                        </button>
                    </div>

                    <div class="chat-tail">
                        <ChatComposer />
                    </div>
                </div>
            </div>
        </div>

        @if (_isFilesPanelOpen)
        {
            @* Keyed on the chat: the page stays when the chat changes, and
               a file open in the panel must not stay open in the next one. *@
            <ChatFilesPanel
                @key="Session.ChatId"
                AssistantFiles="Session.AssistantFiles"
                ChatFiles="Session.ChatFiles"
                ReadFileText="Session.ReadFileTextAsync"
            />
        }
    </div>
}
