@page "/chat"
@page "/chat/{ChatId:guid?}"
@rendermode InteractiveServer
@using Microsoft.Extensions.AI
@using kisatsingen.Components.Chat

<PageTitle>Chat</PageTitle>

<div class="chat-layout">
    <div class="chat-page">
        <div class="chat-container">
            @if (Session.HasVisibleMessages) {
                <div class="chat-log" role="log" aria-live="polite">
                    @foreach (var message in Session.Committed)
                    {
                        if (message.Role == ChatRole.User)
                        {
                            <UserBubble @key="message.Id" Message="message" />
                        }
                        else
                        {
                            <AssistantMessage @key="message.Id" Message="message" />
                        }
                    }
                    @if (Session.StreamingId is Guid streamingId)
                    {
                        <StreamingChatMessage Id="streamingId" />
                    }
                </div>
            } else {
                <div class="chat-greeting">
                    <span class="chat-greeting-emoji">🖕</span>
                    <h1 class="chat-greeting-text">Skjer a din pikk!</h1>
                </div>
            }

            <div class="chat-composer">
                <textarea id="chat-textarea"
                          class="ds-textfield chat-textarea"
                          placeholder="Spør om hva som helst..."
                          rows="1"
                          disabled="@Session.IsBusy"
                          @bind="MessageText"
                          @bind:event="oninput"
                          @onkeydown="OnComposerKeyDownAsync"></textarea>

                <div class="chat-composer-actions">
                    <button class="composer-icon-button" type="button" aria-label="Legg ved fil" disabled="@Session.IsBusy">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <line x1="12" y1="5" x2="12" y2="19"/>
                            <line x1="5" y1="12" x2="19" y2="12"/>
                        </svg>
                    </button>
                    <button class="composer-send-button"
                            type="button"
                            aria-label="Send melding"
                            disabled="@(Session.IsBusy || string.IsNullOrWhiteSpace(MessageText))"
                            @onclick="SendAsync">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                            <line x1="12" y1="19" x2="12" y2="5"/>
                            <polyline points="5 12 12 5 19 12"/>
                        </svg>
                    </button>
                </div>
            </div>

            <p class="ds-paragraph chat-footer">Claude kan gjøre feil (ikke vi). Sjekk viktige svar.</p>
        </div>
    </div>
</div>
