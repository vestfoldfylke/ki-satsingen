<Project>
    <PropertyGroup>
        <!-- Check the .editorconfig style rules when building, not only in the editor. -->
        <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>

        <!-- Needed for the build to report unused usings (IDE0005). We don't use the XML docs. -->
        <GenerateDocumentationFile>true</GenerateDocumentationFile>

        <!-- Don't require XML doc comments on public members (CS1591). -->
        <NoWarn>$(NoWarn);CS1591</NoWarn>

        <TreatWarningsAsErrors>true</TreatWarningsAsErrors>

        <!-- Known vulnerabilities in NuGet packages stay warnings, so a newly published
             one doesn't stop every build and deploy until the package is updated. -->
        <WarningsNotAsErrors>$(WarningsNotAsErrors);NU1901;NU1902;NU1903;NU1904</WarningsNotAsErrors>
    </PropertyGroup>
</Project>
